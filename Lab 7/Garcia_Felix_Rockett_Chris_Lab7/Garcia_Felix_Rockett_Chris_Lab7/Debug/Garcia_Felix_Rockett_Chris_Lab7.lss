                                 ;***********************************************************
                                 ;*	Additional Program Includes
                                 ;***********************************************************
                                 .include "LCDDriver.asm"		; Include the LCD Driver
                                 
                                 ;*	Oregon State University
                                 ;*	ST7565R LCD Driver
                                 ;*	This code configures the graphical LCD and emulates
                                 ;*	the behavior of a 2x16 character display.
                                 ;*
                                 ;*	The LCD has room for 32 characters in total
                                 ;*	(16 on the top and 16 on the bottom).
                                 ;*	The upper 16 characters should be located in SRAM starting at 0x0100.
                                 ;*	The lower 16 characters should be located in SRAM starting at 0x0110.
                                 ;*
                                 ;*	NOTE: Register r16 MUST be named 'mpr' in the Main Code
                                 ;*	Something like this:
                                 ;*	.def	mpr = r16
                                 ;*
                                 ;*	WARNING: Register r20-r22 are reserved and cannot be
                                 ;*		renamed outside of the LCD Driver functions. Doing
                                 ;*		so will damage the functionality of the LCD Driver
                                 ;*
                                 ;*	Acknowledgements: the Bin2ASCII and div10 procedures were written by
                                 ;*	David Zier for a previous board. The code has been retained intact.
                                 ;*
                                 ;*********************************************************************
                                 ;*	Rev	Date		Name			Description
                                 ;*--------------------------------------------------------------------
                                 ;*	-	8/18/22	Justin Goins	Version 1.0
                                 ;*
                                 ;*
                                 ;*********************************************************************
                                 
                                 .include "m32U4def.inc"				; Include definition file
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega32U4.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m32U4def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega32U4
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega32U4
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M32U4DEF_INC_
                                 #endif  /* _M32U4DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Register definitions
                                 .def	count = r20			; Character Counter
                                 .def	q = r21			; Quotient for div10
                                 .def	r = r22			; Remander for div10
                                 
                                 ; The following constants are not intended to be modified.
                                 .equ	lcd_buffer_addr = 0x0100 ; define the SRAM base address of the LCD buffer
                                 
                                 ; This information is gathered from the ST7565R datasheet.
                                 ; define some command patterns
                                 .equ	lcd_c_disp_en = 0b10101110 ; lsb indicates whether the LCD is on (1) or off (0)
                                 .equ	lcd_c_disp_set_start_ln = 0b01000000 ; lower 6 bits indicate the line index (0 - 63)
                                 .equ	lcd_c_disp_set_page_addr = 0b10110000 ; lower 4 bits indicate the page address (page 3 is at top and page 0 is at bottom)
                                 ; together, these commands allow you to specify a column index from (0 - 131):
                                 .equ	lcd_c_disp_set_col_addr_h = 0b00010000 ; lower 4 bits indicate the 4 high bits of the column address
                                 .equ	lcd_c_disp_set_col_addr_l = 0b00000000 ; lower 4 bits indicate the 4 low bits of the column address
                                 .equ	lcd_c_disp_set_invert = 0b10100110 ; lsb indicates whether the LCD is normal (0) or inverted (1)
                                 .equ	lcd_c_disp_fill = 0b10100100 ; lsb indicates whether the LCD is normal (0) or filled with dots (1)
                                 .equ	lcd_c_disp_reset = 0b11100010 ; resets the line/page addresses and other stuff, does not affect data RAM
                                 .equ	lcd_c_disp_set_bias = 0xA2 ; 1/6 bias (in 1/33 duty mode)
                                 .equ	lcd_c_disp_set_scandir = 0b11000000 ; select normal scan direction (most significant bit is placed at top of LCD)
                                 .equ	lcd_c_disp_set_contrast_1 = 0b10000001 ; first we send this command then we pass the value
                                 .equ	lcd_c_disp_set_contrast_2 = 15 ; can select a contrast value between 1 and 63
                                 .equ	lcd_c_disp_set_res_ratio = 0x22 ; see the datasheet
                                 .equ	lcd_c_disp_vreg_on = 0x2F ; enable voltage booster, voltage regulator, and voltage follower
                                 
                                 ; use this command to write into the LCD RAM:
                                 .equ	lcd_c_disp_write = 0b00000000 ; these 8 bits are the data to be placed in the target. 
                                 ; note that the column address is automatically incremented by 1 after each write to the LCD data
                                 
                                 ; everything in this driver file needs to go into the code segment
                                 .cseg
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDInit
                                 ;* Desc:	This function initializes the LCD control pins and
                                 ;*		sets reasonable values for the configuration registers.
                                 ;*****************************************************************
                                 LCDInit:
000278 930f                      	push	mpr
                                 
                                 	; set MOSI, SCL, and SS as outputs
000279 9a22                      	sbi	DDRB, DDB2	; Port B 2
00027a 9a21                      	sbi	DDRB, DDB1	; Port B 1
00027b 9a20                      	sbi	DDRB, DDB0	; Port B 0
                                 	; ensure that SS is deactivated (active low)
00027c 9a28                      	sbi	PORTB, 0
                                 	; set lcd_A0 as output
00027d 9a81                      	sbi	DDRF, DDF1	; Port F 1
                                 	; enable LCD backlight control
00027e 9a3f                      	sbi	DDRC, DDC7	; Port C 7
                                 	; set lcd_RST_N as output
00027f 9a80                      	sbi	DDRF, DDF0	; Port F 0
                                 	; we pull lcd_RST_N low for 1 millisecond
000280 9888                      	cbi	PORTF, 0
000281 940e 0363                 	call	LCDDelay
000283 9a88                      	sbi	PORTF, 0
                                 	; Enable SPI mode 3, master configuration, set clock rate fck/2 using SPI2X
000284 e50c                      	ldi	mpr, (1<<SPE)|(1<<MSTR)|(1<<CPOL)|(1<<CPHA)
000285 bd0c                      	out	SPCR, mpr
000286 e001                      	ldi	mpr, (1<<SPI2X)
000287 bd0d                      	out	SPSR, mpr
                                 	; Note: after transmitting a byte, the SPI interrupt flag will
                                 	; be automatically cleared next time we: 1) read SPSR and ALSO 2) access SPDR
                                 
000288 9828                      	cbi	PORTB, 0	; activate slave select
                                 	; send a string of initialization commands
000289 ea02                      	ldi	mpr, lcd_c_disp_set_bias
00028a d0d2                      	rcall	LCD_Internal_WriteCMD
00028b ec00                      	ldi	mpr, lcd_c_disp_set_scandir
00028c d0d0                      	rcall	LCD_Internal_WriteCMD
00028d e801                      	ldi	mpr, lcd_c_disp_set_contrast_1
00028e d0ce                      	rcall	LCD_Internal_WriteCMD
00028f e00f                      	ldi	mpr, lcd_c_disp_set_contrast_2
000290 d0cc                      	rcall	LCD_Internal_WriteCMD
000291 e202                      	ldi	mpr, lcd_c_disp_set_res_ratio
000292 d0ca                      	rcall	LCD_Internal_WriteCMD
000293 e20f                      	ldi	mpr, lcd_c_disp_vreg_on
000294 d0c8                      	rcall	LCD_Internal_WriteCMD
000295 ea0f                      	ldi	mpr, (lcd_c_disp_en | 1 << 0)
000296 d0c6                      	rcall	LCD_Internal_WriteCMD
000297 9a28                      	sbi	PORTB, 0	; deactivate slave select
                                 
000298 910f                      	pop	mpr
000299 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDBacklightOn
                                 ;* Desc:	Enables the backlight
                                 ;*****************************************************************
                                 LCDBacklightOn:
00029a 9a47                      	sbi	PORTC, 7
00029b 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDBacklightOff
                                 ;* Desc:	Disables the backlight
                                 ;*****************************************************************
                                 LCDBacklightOff:
00029c 9847                      	cbi	PORTC, 7
00029d 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDWrite
                                 ;* Desc:	This function writes 32 characters to the LCD screen...
                                 ;*		16 chars on the top line and 16 chars on the bottom line.
                                 ;*****************************************************************
                                 LCDWrite:
00029e d002                      	rcall	LCDWrLn1
00029f d00c                      	rcall	LCDWrLn2
0002a0 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDWrLn1
                                 ;* Desc:	This function writes 16 characters to the top line.
                                 ;*****************************************************************
                                 LCDWrLn1:
0002a1 93bf                      	push	XH
0002a2 93af                      	push	XL
0002a3 931f                      	push	r17
                                 	; r17 specifies the destination bank in LCD RAM
0002a4 e013                      	ldi	r17, 3
                                 	; point X at the ASCII data
0002a5 e0b1                      	ldi	XH, HIGH(lcd_buffer_addr)
0002a6 e0a0                      	ldi	XL, LOW(lcd_buffer_addr)
0002a7 d05c                      	rcall	LCD_Internal_WriteLn
0002a8 911f                      	pop	r17
0002a9 91af                      	pop	XL
0002aa 91bf                      	pop	XH
0002ab 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDWrLn2
                                 ;* Desc:	This function writes 16 characters to the bottom line.
                                 ;*****************************************************************
                                 LCDWrLn2:
0002ac 93bf                      	push	XH
0002ad 93af                      	push	XL
0002ae 931f                      	push	r17
                                 	; r17 specifies the destination bank in LCD RAM
0002af e011                      	ldi	r17, 1
                                 	; point X at the ASCII data
0002b0 e0b1                      	ldi	XH, HIGH(lcd_buffer_addr+16)
0002b1 e1a0                      	ldi	XL, LOW(lcd_buffer_addr+16)
0002b2 d051                      	rcall	LCD_Internal_WriteLn
0002b3 911f                      	pop	r17
0002b4 91af                      	pop	XL
0002b5 91bf                      	pop	XH
0002b6 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDClr
                                 ;* Desc:	This function clears the entire LCD screen.
                                 ;*****************************************************************
                                 LCDClr:
0002b7 d022                      	rcall	LCDClrLn1
0002b8 d027                      	rcall	LCDClrLn2
                                 
0002b9 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	CLRDM1
                                 ;* Desc:	This function clears Data Memory by writing 16 
                                 ;*		consecutive ASCII spaces $20 to the memory at $0100.
                                 ;*****************************************************************
                                 CLRDM1:
                                     ; Set X register points to $0100
0002ba 93bf                      	   push	   XH
0002bb 93af                      	   PUSH	   XL
0002bc 930f                                 push    r16
0002bd 931f                                 push    r17
                                 
0002be e0b1                                 ldi     XH, HIGH(lcd_buffer_addr)
0002bf e0a0                                 ldi     XL, LOW(lcd_buffer_addr)
0002c0 e110                                 ldi     r17, 16
0002c1 e200                                 ldi     r16, ' '
                                    CLRloop1:
0002c2 930d                                 st      X+, r16         ; load data to DM
0002c3 951a                                 dec     r17
0002c4 f7e9                                 brne    CLRloop1
                                 
0002c5 911f                      	   pop	   r17
0002c6 910f                      	   pop	   r16
0002c7 91af                      	   pop	   XL
0002c8 91bf                      	   pop	   XH
                                 
0002c9 9508                                 ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	CLRDM2
                                 ;* Desc:	This function clears Data Memory by writing 16 
                                 ;*		consecutive ASCII spaces $20 to the memory at $0110.
                                 ;*****************************************************************
                                 CLRDM2:
                                     ; Set X register points to $0110
0002ca 93bf                      	   push	   XH
0002cb 93af                      	   PUSH	   XL
0002cc 930f                                 push    r16
0002cd 931f                                 push    r17
                                 
0002ce e0b1                                 ldi     XH, HIGH(lcd_buffer_addr+16)
0002cf e1a0                                 ldi     XL, LOW(lcd_buffer_addr+16)
0002d0 e110                                 ldi     r17, 16
0002d1 e200                                 ldi     r16, ' '
                                    CLRloop2:
0002d2 930d                                 st      X+, r16         ; load data to DM
0002d3 951a                                 dec     r17
0002d4 f7e9                                 brne    CLRloop2
                                 
0002d5 911f                      	   pop	   r17
0002d6 910f                      	   pop	   r16
0002d7 91af                      	   pop	   XL
0002d8 91bf                      	   pop	   XH
                                 
0002d9 9508                                 ret
                                 ;*****************************************************************
                                 ;* Func:	LCDClrLn1
                                 ;* Desc:	This function clears the top line of the LCD screen.
                                 ;*****************************************************************
                                 LCDClrLn1:
0002da 931f                      	push	r17
                                 	; r17 specifies the target bank in LCD RAM
0002db e013                      	ldi	r17, 3
0002dc d060                      	rcall	LCD_Internal_ClearLn
0002dd dfdc                      	rcall	CLRDM1
0002de 911f                      	pop	r17
0002df 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDClrLn2
                                 ;* Desc:	This function clears the bottom line of the LCD screen.
                                 ;*****************************************************************
                                 LCDClrLn2:
0002e0 931f                      	push	r17
                                 	; r17 specifies the target bank in LCD RAM
0002e1 e011                      	ldi	r17, 1
0002e2 d05a                      	rcall	LCD_Internal_ClearLn
0002e3 dfe6                      	rcall	CLRDM2
0002e4 911f                      	pop	r17
0002e5 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	Bin2ASCII
                                 ;* Desc:	Converts a binary number into an ASCII 
                                 ;*			text string equivalent. 
                                 ;*			- The binary number needs to be in the mpr
                                 ;*			- The Start Address of where the text will
                                 ;*			 	be placed needs to be in the X Register
                                 ;*			- The count of the characters created are 
                                 ;*				added to the count register
                                 ;*****************************************************************
                                 Bin2ASCII:
0002e6 930f                      	push	mpr			; save mpr
0002e7 936f                      	push	r			; save r
0002e8 935f                      	push	q			; save q
0002e9 93bf                      	push	XH			; save X-pointer
0002ea 93af                      	push	XL			;
                                 
                                 	; Determine the range of mpr
0002eb 3604                      	cpi	mpr, 100		; is mpr >= 100
0002ec f018                      	brlo	B2A_1			; goto next check
0002ed e043                      	ldi	count, 3		; Three chars are written
0002ee 9613                      	adiw	XL, 3			; Increment X 3 address spaces
0002ef c007                      	rjmp	B2A_3			; Continue with program
                                 B2A_1:
0002f0 300a                      	cpi	mpr, 10		; is mpr >= 10
0002f1 f018                      	brlo	B2A_2			; Continue with program
0002f2 e042                      	ldi	count, 2		; Two chars are written
0002f3 9612                      	adiw	XL, 2			; Increment X 2 address spaces
0002f4 c002                      	rjmp	B2A_3			; Continue with program
                                 B2A_2:
0002f5 9611                      	adiw	XL, 1			; Increment X 1 address space
0002f6 e041                      	ldi	count, 1		; One char is written
                                 
                                 B2A_3:
                                 	; Do-While statement that converts Binary to ASCII
0002f7 d076                      	rcall	div10			; Call the div10 function
0002f8 e300                      	ldi	mpr, '0'		; Set the base ASCII integer value
0002f9 0f06                      	add	mpr, r		; Create the ASCII integer value
0002fa 930e                      	st	-X, mpr		; Load ASCII value to memory
0002fb 2f05                      	mov	mpr, q		; Set mpr to quotient value
0002fc 3000                      	cpi	mpr, 0		; does mpr == 0
0002fd f7c9                      	brne	B2A_3			; do while (mpr != 0)
                                 
0002fe 91af                      	pop	XL			; restore X-pointer
0002ff 91bf                      	pop	XH			;
000300 915f                      	pop	q			; restore q
000301 916f                      	pop	r			; restore r
000302 910f                      	pop	mpr			; restore mpr
000303 9508                      	ret				; return from function
                                 
                                 ;*****************************************************************
                                 ;*	The functions below here are intended for internal use only.
                                 ;*****************************************************************
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCD_Internal_WriteLn
                                 ;* Desc:	Sends 16 characters of information to the LCD panel
                                 ;*		This is slightly more complicated than it sounds because the
                                 ;*		characters straddle two banks of the LCD memory.
                                 ;*		X is pointing at the first ASCII character to be displayed.
                                 ;*		r17 holds the index of the destination bank in LCD RAM.
                                 ;*		
                                 ;*****************************************************************
                                 LCD_Internal_WriteLn:
000304 920f                      	push	r0
000305 921f                      	push	r1
000306 930f                      	push	mpr
000307 932f                      	push	r18
000308 933f                      	push	r19
000309 938f                      	push	r24
00030a 939f                      	push	r25
00030b 93ef                      	push	ZL
00030c 93ff                      	push	ZH
                                 
                                 	; r25:24 holds a pointer to the base address of the bitmap array
00030d e097                      	ldi	r25, HIGH(FontBitmap << 1);
00030e e288                      	ldi	r24, LOW(FontBitmap << 1);
                                 
00030f 9828                      	cbi	PORTB, 0	; activate slave select
                                 
                                 	; use a counter to track if we are on the top chunk or bottom chunk of each char
000310 e022                      	ldi	r18, 2
                                 
                                 LCD_WL_display_bank:
                                 	; set the column to 0
000311 e100                      	ldi	mpr, lcd_c_disp_set_col_addr_h
000312 d04a                      	rcall	LCD_Internal_WriteCMD
000313 e000                      	ldi	mpr, lcd_c_disp_set_col_addr_l
000314 d048                      	rcall	LCD_Internal_WriteCMD
                                 	; we need to select the appropriate page
000315 eb00                      	ldi	mpr, lcd_c_disp_set_page_addr
000316 2b01                      	or	mpr, r17	; set the lower 4 bits
000317 d045                      	rcall	LCD_Internal_WriteCMD
                                 
000318 e130                      	ldi	r19, 16	; there are 16 characters per line
                                 
                                 LCD_WL_next_char:
                                 	; get ascii code point & determine location of corresponding character bitmap
000319 900d                      	ld	r0, X+	; this should be a value from 0 to 255
00031a e100                      	ldi	mpr, 16	; there are 16 bytes per character
00031b 9e00                      	mul	r0, mpr	; determine the byte offset for the desired char
00031c 01fc                      	movw	ZH:ZL, r25:r24	; copy the base address to Z
00031d 0de0                      	add	ZL, r0	; finally, compute a pointer to the char bitmap
00031e 1df1                      	adc	ZH, r1
                                 
00031f e008                      	ldi	mpr, 8	; there are 8 columns for each character
                                 
                                 	; this is where we display the chunk of character (either a top chunk or bottom chunk)
000320 9004                      	lpm	r0, Z
                                 LCD_WL_next_col:
000321 bc0e                      	out	SPDR, r0
000322 9a89                      	sbi	PORTF, 1	; set lcd_A0 to specify data mode
000323 9632                      	adiw	ZH:ZL, 2	; point Z at the next column for this bank
000324 9004                      	lpm	r0, Z		; this is a sneaky way to save a few clock cycles (since we are waiting for the SPI communication)
                                 LCD_WL_wait_spi:
000325 b41d                      	in	r1, SPSR
000326 fe17                      	sbrs	r1, SPIF	; wait for SPI to finish
000327 cffd                      	rjmp	LCD_WL_wait_spi
                                 
                                 	; keep going until we have displayed all the columns for this character
000328 950a                      	dec	mpr
000329 f7b9                      	brne	LCD_WL_next_col
                                 
                                 	; move to the next character
00032a 953a                      	dec	r19
00032b f769                      	brne	LCD_WL_next_char
                                 
                                 	; if we are at the end of the line, configure the bank and starting array offset for the bottom half of each char
00032c 952a                      	dec	r18		; did we display both banks yet?
00032d f021                      	breq	LCD_WL_all_done
                                 	; if not, then prepare to display the bottom chunk of each character
00032e 951a                      	dec	r17		; decrement the bank number
00032f 9750                      	sbiw	XH:XL, 16	; X needs to point back at the beginning character of the line
000330 9601                      	adiw	r25:r24, 1	; increment the base address pointer (now it will point to the second chunk of each char)
000331 cfdf                      	rjmp	LCD_WL_display_bank
                                 
                                 LCD_WL_all_done:
000332 9a28                      	sbi	PORTB, 0	; deactivate slave select
                                 
000333 91ff                      	pop	ZH
000334 91ef                      	pop	ZL
000335 919f                      	pop	r25
000336 918f                      	pop	r24
000337 913f                      	pop	r19
000338 912f                      	pop	r18
000339 910f                      	pop	mpr
00033a 901f                      	pop	r1
00033b 900f                      	pop	r0
00033c 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCD_Internal_ClearLn
                                 ;* Desc:	This function clears two of the LCD memory banks.
                                 ;*		r17 specifies the starting bank to wipe.
                                 ;*****************************************************************
                                 LCD_Internal_ClearLn:
00033d 930f                      	push	mpr
00033e 921f                      	push	r1
00033f 932f                      	push	r18
000340 933f                      	push	r19
                                 
000341 9828                      	cbi	PORTB, 0	; activate slave select
000342 e032                      	ldi	r19, 2	; we are going to clear two banks
                                 
                                 LCD_CLRLN_clear_bank:
                                 	; set the column to 0
000343 e100                      	ldi	mpr, lcd_c_disp_set_col_addr_h
000344 d018                      	rcall	LCD_Internal_WriteCMD
000345 e000                      	ldi	mpr, lcd_c_disp_set_col_addr_l
000346 d016                      	rcall	LCD_Internal_WriteCMD
                                 	; we need to select the appropriate page
000347 eb00                      	ldi	mpr, lcd_c_disp_set_page_addr
000348 2b01                      	or	mpr, r17	; configure the lower 4 bits
000349 d013                      	rcall	LCD_Internal_WriteCMD
                                 
00034a e820                      	ldi	r18, 128	; there are 128 columns on the LCD
00034b 2700                      	clr	mpr		; we will fill each column with empty dots (i.e. blank space)
00034c 9a89                      	sbi	PORTF, 1	; set lcd_A0 to specify data mode
                                 
                                 LCD_CLRLN_write_col:
00034d bd0e                      	out	SPDR, mpr	; send an empty column to the LCD via SPI
                                 LCD_CLRLN_wait_spi:
00034e b41d                      	in	r1, SPSR
00034f fe17                      	sbrs	r1, SPIF	; wait for SPI to finish
000350 cffd                      	rjmp	LCD_CLRLN_wait_spi
                                 
000351 952a                      	dec	r18
000352 f7d1                      	brne	LCD_CLRLN_write_col	; cycle through all 128 columns
                                 
                                 	; clear the remaining bank if we haven't done so already
000353 953a                      	dec	r19
000354 f011                      	breq	LCD_CLRLN_all_done
000355 951a                      	dec	r17		; decrement the bank index
000356 cfec                      	rjmp	LCD_CLRLN_clear_bank
                                 
                                 LCD_CLRLN_all_done:
000357 9a28                      	sbi	PORTB, 0	; deactivate slave select	
                                 	
                                 	; pop registers...
000358 913f                      	pop	r19
000359 912f                      	pop	r18
00035a 901f                      	pop	r1
00035b 910f                      	pop	mpr
00035c 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCD_Internal_WriteCMD
                                 ;* Desc:	Sends the byte in mpr
                                 ;*		If you use this function directly,
                                 ;*		YOU ARE RESPONSIBLE for handling the slave select line!
                                 ;*****************************************************************
                                 LCD_Internal_WriteCMD:
00035d bd0e                      	out	SPDR, mpr	; initiate transmission
00035e 9889                      	cbi	PORTF, 1	; clear lcd_A0 to put the lcd into command mode
                                 				; (this just has to be done before the 8th bit
                                 				; is transmitted via SPI)
                                 LCD_IWC_L1:
00035f b50d                      	in	mpr, SPSR
000360 ff07                      	sbrs	mpr, SPIF	; wait for SPI to finish
000361 cffd                      	rjmp LCD_IWC_L1
000362 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDDelay
                                 ;* Desc:	A wait loop that will consume roughly 1ms
                                 ;*		Note that a CALL takes 4 cycles on top of this delay.
                                 ;*****************************************************************
                                 LCDDelay:
000363 930f                      	push	mpr		; 2 cycles
000364 931f                      	push	r17		; 2 cycles
000365 e01b                      	ldi	r17, 11	; 1 cycle
                                 LCDDelay_L1:
000366 ef02                      	ldi	mpr, 242	; 1 cycle
                                 LCDDelay_L2:
000367 950a                      	dec	mpr		; 1 cycle
000368 f7f1                      	brne	LCDDelay_L2	; 2 cycles on branch, 1 if no branch
000369 951a                      	dec	r17		; 1 cycle
00036a f7d9                      	brne	LCDDelay_L1	; 2 cycles on branch, 1 if no branch
00036b 911f                      	pop	r17		; 2 cycles
00036c 910f                      	pop	mpr		; 2 cycles
00036d 9508                      	ret			; 4 cycles
                                 
                                 ;*****************************************************************
                                 ;* Func:	div10
                                 ;* Desc:	Divides the value in the mpr by 10 and 
                                 ;*			puts the remainder in the 'r' register
                                 ;*			and the quotient in the 'q' register.
                                 ;*	DO NOT modify this function, trust me, it does
                                 ;*	divide by 10 :)  ~DZ		
                                 ;*****************************************************************
                                 div10:
00036e 920f                      	push	r0		; Save register
                                 
                                 	; q = mpr / 10 = mpr * 0.000110011001101b
00036f 2f50                      	mov	q, mpr	; q = mpr * 1.0b
000370 9556                      	lsr	q		; q >> 2
000371 9556                      	lsr	q		; q = mpr * 0.01b
000372 0f50                      	add	q, mpr	; q = (q + mpr) >> 1
000373 9556                      	lsr	q		; q = mpr * 0.101b
000374 0f50                      	add	q, mpr	; q = (q + mpr) >> 3
000375 9556                      	lsr	q
000376 9556                      	lsr	q
000377 9556                      	lsr	q		; q = mpr * 0.001101b
000378 0f50                      	add	q, mpr	; q = (q + mpr) >> 1
000379 9556                      	lsr	q		; q = mpr * 0.1001101b
00037a 0f50                      	add	q, mpr	; q = (q + mpr) >> 3
00037b 9556                      	lsr	q				
00037c 9556                      	lsr	q
00037d 9556                      	lsr	q		; q = mpr * 0.0011001101b
00037e 0f50                      	add	q, mpr	; q = (q + mpr) >> 1
00037f 9556                      	lsr	q		; q = mpr * 0.10011001101b
