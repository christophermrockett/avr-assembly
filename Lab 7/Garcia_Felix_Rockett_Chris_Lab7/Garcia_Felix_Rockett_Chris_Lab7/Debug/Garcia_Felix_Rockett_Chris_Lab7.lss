                                 ;----------------------------------------------------------------
                                 ; Sub:	RPS
                                 ; Desc:	Cycles and displays rock, paper, scissors choice
                                 ;		
                                 ;----------------------------------------------------------------
                                 RPS:
000204 930f                      		push	mpr			; Save mpr register
000205 b70f                      		in		mpr, SREG	; Save program state
000206 930f                      		push	mpr		
000207 931f                      		push	mpr2
000208 937f                      		push	waitcnt
                                 
000209 9523                      		inc		choice			; Increments choice variable
00020a 3023                      		cpi		choice, 3		; Resets choice to Rock if incremented past Scissors (2)
00020b f409                      		brne	SELECTION
00020c 2722                      		clr		choice
                                 
                                 SELECTION:
00020d 3020                      		cpi		choice, 0		; 0 = Rock
00020e f019                      		breq	ROCK
00020f 3021                      		cpi		choice, 1		; 1 = Paper
000210 f019                      		breq	PAPER
000211 c004                      		rjmp	SCISSORS		; 2 = Scissors
                                 
                                 ROCK:
000212 df79                      		rcall	DisplayRock		; Displays Rock screen
000213 c004                      		rjmp	DONE
                                 PAPER:
000214 df9f                      		rcall	DisplayPaper	; Displays Paper sreen
000215 c002                      		rjmp	DONE
                                 SCISSORS:
000216 dfc5                      		rcall	DisplayScissors	; Displays Scissors screen
000217 c000                      		rjmp	DONE
                                 
                                 DONE:
000218 e001                      		ldi		mpr, 0b0000_0001	; Clears any interrupt queues
000219 bb0c                      		out		EIFR, mpr
                                 
00021a 917f                      		pop		waitcnt
00021b 911f                      		pop		mpr2
00021c 910f                      		pop		mpr
00021d bf0f                      		out		SREG, mpr
00021e 910f                      		pop		mpr
                                 
00021f 9508                      		ret
                                 
