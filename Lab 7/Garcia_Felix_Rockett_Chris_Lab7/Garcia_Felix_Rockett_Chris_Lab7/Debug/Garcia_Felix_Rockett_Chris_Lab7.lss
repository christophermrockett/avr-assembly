                                 .equ	OC4Daddr	= 0x0050	; Timer/Counter4 Compare Match D
                                 .equ	OVF4addr	= 0x0052	; Timer/Counter4 Overflow
                                 .equ	TIMER4_FPFaddr	= 0x0054	; Timer/Counter4 Fault Protection Interrupt
                                 
                                 .equ	INT_VECTORS_SIZE	= 86	; size in words
                                 
                                 #endif  /* _M32U4DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;***********************************************************
                                 ;*
                                 ;*	This is the TRANSMIT skeleton file for Lab 7 of ECE 375
                                 ;*
                                 ;*  	Rock Paper Scissors
                                 ;* 	Requirement:
                                 ;* 	1. USART1 communication
                                 ;* 	2. Timer/counter1 Normal mode to create a 1.5-sec delay
                                 ;***********************************************************
                                 ;*
                                 ;*	 Author: Christopher Rockett
                                 ;*	   Date: 2/25/2026
                                 ;*
                                 ;***********************************************************
                                 
                                 .include "m32U4def.inc"         ; Include definition file
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega32U4.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m32U4def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega32U4
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega32U4
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M32U4DEF_INC_
                                 #endif  /* _M32U4DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;***********************************************************
                                 ;*  Internal Register Definitions and Constants
                                 ;***********************************************************
                                 .def    mpr = r16               ; Multi-Purpose Register
                                 .def	mpr2 = r17			; Wait Loop Counter
                                 .def	choice = r18
                                 .def	i = r19
                                 .def	waitcnt = r23
                                 
                                 ; Use this signal code between two boards for their game ready
                                 .equ    SendReady = 0b11111111
                                 
                                 ;***********************************************************
                                 ;*  Start of Code Segment
                                 ;***********************************************************
                                 .cseg                           ; Beginning of code segment
                                 
                                 ;***********************************************************
                                 ;*  Interrupt Vectors
                                 ;***********************************************************
                                 .org    $0000                   ; Beginning of IVs
000000 c055                      	    rjmp    INIT            	; Reset interrupt
                                 
                                 .org	$0002					; INT0 interrupt
000002 d201                      		rcall	RPS				; Goes through Rock, Paper, Scissors
000003 9518                      		reti
                                 
                                 .org    $0056                   ; End of Interrupt Vectors
                                 
                                 ;***********************************************************
                                 ;*  Program Initialization
                                 ;***********************************************************
                                 INIT:
                                 	;Stack Pointer (VERY IMPORTANT!!!!)
000056 ef0f                      		ldi		mpr, low(RAMEND)
000057 bf0d                      		out		SPL, mpr		; Load SPL with low byte of RAMEND
000058 e00a                      		ldi		mpr, high(RAMEND)
000059 bf0e                      		out		SPH, mpr		; Load SPH with high byte of RAMEND
                                 	
                                 	;I/O Ports
                                 	; Initialize Port D for input
00005a e008                      		ldi		mpr, $08		; Set Port D Data Direction Register
00005b b90a                      		out		DDRD, mpr		; for input and PD3 to output transmitting
00005c ef0f                      		ldi		mpr, $FF		; Initialize Port D Data Register
00005d b90b                      		out		PORTD, mpr		; so all Port D inputs are Tri-State
                                 
                                 		; Initialize Port B for output
00005e ef0f                      		ldi		mpr, $FF		; Set Port B Data Direction Register
00005f b904                      		out		DDRB, mpr		; for output
000060 e000                      		ldi		mpr, $00		; Initialize Port B Data Register
000061 b905                      		out		PORTB, mpr		; so all Port B outputs are low
                                 
                                 	;USART1
                                 		;Set baudrate at 2400bps
                                 		;Enable receiver and transmitter
                                 		;Set frame format: 8 data bits, 2 stop bits
                                 
                                 		; Set baud rate
000062 e003                      		ldi	mpr, 0x03		; 832 (0x0340) UBRR high byte
000063 9300 00cd                 		sts UBRR1H, mpr
000065 e400                      		ldi	mpr, 0x40		; 832 (0x0340) UBRR low byte
000066 9300 00cc                 		sts UBRR1L, mpr
                                 		; Enable receiver and transmitter
000068 e108                      		ldi mpr, (1<<RXEN1)|(1<<TXEN1)
000069 9300 00c9                 		sts UCSR1B, mpr
                                 		; Set frame format: 8data, 2stop bit
00006b e00e                      		ldi mpr, (1<<USBS1)|(3<<UCSZ10)
00006c 9300 00ca                 		sts UCSR1C, mpr
                                 
                                 	;TIMER/COUNTER1
                                 		;Set Normal mode
                                 
00006e e000                      		ldi	mpr, 0b00000000 ; Sets Timer1 to normal mode
00006f 9300 0080                 		sts	TCCR1A, mpr
                                 
                                 		; Prescaler 256
                                 		; Value = 18661
                                 
000071 ec04                      		ldi mpr, 0b11000100 ; Prescaling 256 clock
000072 9300 0081                 		sts TCCR1B, mpr
                                 
                                 	;Other
                                 	; Initialize LCD Display
000074 d203                      		rcall	LCDInit			; Initializes LCD
000075 d241                      		rcall	LCDClr			; Clears dots on LCD
                                 
                                 		; Configure External Interrupts, if needed
000076 e002                      		ldi		mpr, 0b0000_0010	; Sets intterupts INT0, INT1, and INT3 to falling edge (10) (0-3, and 6-7 bits)
000077 9300 0069                 		sts		EICRA, mpr
                                 
000079 e001                      		ldi		mpr, 0b0000_0001	; Sets INT0
00007a bb0d                      		out		EIMSK, mpr
                                 
                                 
                                 ;***********************************************************
                                 ;*  Main Program
                                 ;***********************************************************
                                 MAIN:
00007b d01f                      		rcall	DisplayStart	; Shows Start Screen Initially
00007c ef2f                      		ldi		choice, -1		; Sets choice to -1 to start at Rock in cycle
                                 		
00007d b109                      		in		mpr, PIND		; Get button input from Port D
00007e 7800                      		andi	mpr, (0b10000000)	; Sets inputs and outputs for buttons (Active Low)
00007f 3000                      		cpi		mpr, (0b00000000)	; Check for ButtClr input (Recall Active Low)
000080 f7d1                      		brne	MAIN			; Loops Main Function
000081 d08a                      		rcall	Play			; Call play function
000082 cff8                      		rjmp	MAIN			; Continue with program
                                 		
                                 
                                 
                                 ;***********************************************************
                                 ;*	Functions and Subroutines
                                 ;***********************************************************
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	DisplayWin
                                 ; Desc:	Displays "You won!" on first line of LCD
                                 ;		
                                 ;----------------------------------------------------------------
                                 WAIT_15sec:
000083 930f                      	push	mpr			; Save mpr register
000084 b70f                      	in		mpr, SREG	; Save program state
000085 930f                      	push	mpr				
000086 931f                      	push	mpr2
000087 937f                      	push	waitcnt
000088 933f                      	push	i
                                 
000089 ee05                      	ldi		mpr, low(0x48E5)	; 18661 = 0x48E5 read low first 1.5 secs
00008a e418                      	ldi		mpr2, high(0x48E5)  ; 18661 = 0x48E5
00008b 9310 0085                 	sts		TCNT1H, mpr2		; Write high first
00008d 9300 0084                 	sts		TCNT1L, mpr			; Write high first
                                 
                                 ; Wait for TCNT1 to roll over 
                                 CHECK: 
00008f b306                      	in		mpr, TIFR1		; Read in TIFR1  
000090 7001                      	andi	mpr, 0b00000001	; Check if TOV1 set  
000091 f3e9                      	breq	CHECK 		; Loop if TOV1 not set 
000092 e001                      	ldi		mpr, 0b00000001	; Otherwise, Reset TOV1  
000093 bb06                      	out		TIFR1, mpr 		; Note - write 1 to reset 
                                 
000094 913f                      	pop		i
000095 917f                      	pop		waitcnt
000096 911f                      	pop		mpr2
000097 910f                      	pop		mpr			; Save mpr register
000098 bf0f                      	out		SREG, mpr	; Save program state
000099 910f                      	pop		mpr			
                                 
00009a 9508                      	ret
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	DisplayStart
                                 ; Desc:	Sets LCD to display words from program memory
                                 ;		
                                 ;----------------------------------------------------------------
                                 DisplayStart:
00009b 930f                      		push	mpr			; Save mpr register
00009c b70f                      		in		mpr, SREG	; Save program state
00009d 930f                      		push	mpr			
00009e 931f                      		push	mpr2
                                 
00009f d1fa                      		rcall	LCDBacklightOn				; LCD Backlight on
0000a0 d219                      		rcall	CLRDM1						; Clears both lines with spaces
0000a1 d228                      		rcall	CLRDM2
0000a2 e4e0                      		ldi		ZL, low(START1_STRING<<1)		; Gets address of lower string and stores to pointer Z
0000a3 e0f4                      		ldi		ZH, high(START1_STRING<<1)		; Gets address of higher string and stores to pointer Z
0000a4 e0a0                      		ldi		XL, low($0100)				; Gets address of lower 0100 data stores to pointer X for first line of LCD
0000a5 e0b1                      		ldi		XH, high($0100)				; Gets address of higher 0100 data stores to pointer X for first line of LCD
                                 
0000a6 e130                      		ldi		i, 16						; Sets loop number
                                 
                                 LOOP1:
0000a7 9105                      		lpm		mpr, z+						; Sends Z data into mpr register
0000a8 930d                      		st		X+, mpr						; Sends mpr data into X pointer then increases address by 1
0000a9 953a                      		dec		i							; Decrements i
0000aa f7e1                      		brne	LOOP1						; Keeps going though loop till i is 0
                                 
0000ab e1a0                      		ldi		XL, low($0110)				; Initializes X pointer address to beginning of second line
0000ac e0b1                      		ldi		XH, high($0110)
0000ad e5e0                      		ldi		ZL, low(START2_STRING<<1)		; Gets address of lower string and stores to pointer Z
0000ae e0f4                      		ldi		ZH, high(START2_STRING<<1)		; Gets address of higher string and stores to pointer Z
                                 
                                 
                                 
0000af e130                      		ldi		i, 16						; Sets loop number
                                 LOOP2:
0000b0 9105                      		lpm		mpr, z+						; Sends new z data to mpr register
0000b1 930d                      		st		X+, mpr						; mpr data stored into X pointer then increases
0000b2 953a                      		dec		i							; Decrements i
0000b3 f7e1                      		brne	LOOP2						; Keeps going through loop till i is 0
                                 		
0000b4 d1e9                      		rcall	LCDWrite					; Writes data onto LCD because of their addresses
                                 
                                 		
                                 		; Restore variables by popping them from the stack,
                                 		; in reverse order
0000b5 911f                      		pop		mpr2
0000b6 910f                      		pop		mpr							; Pops old mpr value
0000b7 bf0f                      		out		SREG, mpr					; Restores old SREG value
0000b8 910f                      		pop		mpr							; Pops old mpr value
                                 
0000b9 9508                      		ret						
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	DisplayReady
                                 ; Desc:	Sets LCD to display words from program memory
                                 ;		
                                 ;----------------------------------------------------------------
                                 DisplayReady:
0000ba 930f                      		push	mpr			; Save mpr register
0000bb b70f                      		in		mpr, SREG	; Save program state
0000bc 930f                      		push	mpr			;		; Execute the function here
                                 
0000bd d1dc                      		rcall	LCDBacklightOn				; LCD Backlight on
0000be d1fb                      		rcall	CLRDM1						; Clears both lines with spaces
0000bf d20a                      		rcall	CLRDM2
0000c0 e6e0                      		ldi		ZL, low(WAIT1_STRING<<1)		; Gets address of lower string and stores to pointer Z
0000c1 e0f4                      		ldi		ZH, high(WAIT1_STRING<<1)		; Gets address of higher string and stores to pointer Z
0000c2 e0a0                      		ldi		XL, low($0100)				; Gets address of lower 0100 data stores to pointer X for first line of LCD
0000c3 e0b1                      		ldi		XH, high($0100)				; Gets address of higher 0100 data stores to pointer X for first line of LCD
                                 
0000c4 e130                      		ldi		i, 16						; Sets loop number
                                 
                                 LOOP3:
0000c5 9105                      		lpm		mpr, z+						; Sends Z data into mpr register
0000c6 930d                      		st		X+, mpr						; Sends mpr data into X pointer then increases address by 1
0000c7 953a                      		dec		i							; Decrements i
0000c8 f7e1                      		brne	LOOP3						; Keeps going though loop till i is 0
                                 
0000c9 e1a0                      		ldi		XL, low($0110)				; Initializes Y pointer address to beginning of second line
0000ca e0b1                      		ldi		XH, high($0110)
0000cb e7e0                      		ldi		ZL, low(WAIT2_STRING<<1)		; Gets address of lower string and stores to pointer Z
0000cc e0f4                      		ldi		ZH, high(WAIT2_STRING<<1)		; Gets address of higher string and stores to pointer Z
                                 
                                 
                                 
0000cd e130                      		ldi		i, 16						; Sets loop number
                                 LOOP4:
0000ce 9105                      		lpm		mpr, z+						; Sends new z data to mpr register
0000cf 930d                      		st		X+, mpr						; mpr data stored into X pointer then increases
0000d0 953a                      		dec		i							; Decrements i
0000d1 f7e1                      		brne	LOOP4						; Keeps going through loop till i is 0
                                 		
0000d2 d1cb                      		rcall	LCDWrite					; Writes data onto LCD because of their addresses
                                 
                                 		
                                 		; Restore variables by popping them from the stack,
                                 		; in reverse order
0000d3 910f                      		pop		mpr							; Pops old mpr value
0000d4 bf0f                      		out		SREG, mpr					; Restores old SREG value
0000d5 910f                      		pop		mpr							; Pops old mpr value
                                 
0000d6 9508                      		ret						
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	DisplayGame
                                 ; Desc:	Sets LCD to display words from program memory
                                 ;		
                                 ;----------------------------------------------------------------
                                 DisplayGame:
0000d7 930f                      		push	mpr			; Save mpr register
0000d8 b70f                      		in		mpr, SREG	; Save program state
0000d9 930f                      		push	mpr			;		; Execute the function here
                                 
0000da d1bf                      		rcall	LCDBacklightOn				; LCD Backlight on
0000db d1de                      		rcall	CLRDM1						; Clears line with spaces
0000dc d1ed                      		rcall	CLRDM2
0000dd e8e0                      		ldi		ZL, low(GAME_STRING<<1)		; Gets address of lower string and stores to pointer Z
0000de e0f4                      		ldi		ZH, high(GAME_STRING<<1)		; Gets address of higher string and stores to pointer Z
0000df e0a0                      		ldi		XL, low($0100)				; Gets address of lower 0100 data stores to pointer X for first line of LCD
0000e0 e0b1                      		ldi		XH, high($0100)				; Gets address of higher 0100 data stores to pointer X for first line of LCD
                                 
0000e1 e130                      		ldi		i, 16						; Sets loop number
                                 
                                 LOOP5:
0000e2 9105                      		lpm		mpr, z+						; Sends Z data into mpr register
0000e3 930d                      		st		X+, mpr						; Sends mpr data into X pointer then increases address by 1
0000e4 953a                      		dec		i							; Decrements i
0000e5 f7e1                      		brne	LOOP5						; Keeps going though loop till i is 0
                                 		
0000e6 d1b7                      		rcall	LCDWrite					; Writes data onto LCD because of their addresses
                                 
0000e7 910f                      		pop		mpr							; Pops old mpr value
0000e8 bf0f                      		out		SREG, mpr					; Restores old SREG value
0000e9 910f                      		pop		mpr							; Pops old mpr value
                                 
0000ea 9508                      		ret						
                                 ;----------------------------------------------------------------
                                 ; Sub:	USART_Transmit
                                 ; Desc:	Waits for empty trasmit buffer
                                 ;		
                                 ;----------------------------------------------------------------
                                 USART_Transmit:
0000eb 9110 00c8                 		lds		mpr2, UCSR1A	; Wait for empty transmit buffer
0000ed ff15                      		sbrs	mpr2, UDRE1				
0000ee cffc                      		rjmp	USART_Transmit
0000ef 9508                      		ret
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	USART_Receive
                                 ; Desc:	Waits for data to be received
                                 ;		
                                 ;----------------------------------------------------------------
                                 USART_Receive:
0000f0 9110 00c8                 		lds		mpr2, UCSR1A	; Wait for data to be received
0000f2 ff17                      		sbrs	mpr2, RXC1
0000f3 cffc                      		rjmp	USART_Receive
                                 		
0000f4 9100 00ce                 		lds		mpr, UDR1		; Get and return received data from buffer
0000f6 9508                      		ret
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	LED_Count
                                 ; Desc:	Counts for 6 seconds utilizing LEDS (4-7)
                                 ;		
                                 ;----------------------------------------------------------------
                                 LED_Count:
0000f7 930f                      		push	mpr			; Save mpr register
0000f8 b70f                      		in		mpr, SREG	; Save program state
0000f9 930f                      		push	mpr		
0000fa 931f                      		push	mpr2
0000fb 933f                      		push	i
                                 
0000fc e035                      		ldi		i, 5
0000fd ef10                      		ldi		mpr2, 0xF0			; Light all 4 LEDS Initially
                                 
                                 LOOP6:
0000fe b105                      		in		mpr, PORTB			; Grabs PORTB input
0000ff 700f                      		andi	mpr, 0x0F			; Save lower bit LED values (0-3 bits) for LCD screen
000100 2b01                      		or		mpr, mpr2			; Combines upper and lower bit LED values
000101 b905                      		out		PORTB, mpr			; Displays count
000102 df80                      		rcall	WAIT_15sec			; Shifts LED every 1.5sec
000103 9516                      		lsr		mpr2				; Shift Right
000104 953a                      		dec		i
000105 f7c1                      		brne	LOOP6
                                 
000106 913f                      		pop		i
000107 911f                      		pop		mpr2
000108 910f                      		pop		mpr
000109 bf0f                      		out		SREG, mpr
00010a 910f                      		pop		mpr
                                 
00010b 9508                      		ret
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	Play
                                 ; Desc:	Waits for other player ready and plays game
                                 ;		
                                 ;----------------------------------------------------------------
                                 Play:
                                 		
00010c 930f                      		push	mpr			; Save mpr register
00010d b70f                      		in		mpr, SREG	; Save program state
00010e 930f                      		push	mpr			
                                 
00010f dfaa                      		rcall	DisplayReady	; Displays ready screen
                                 		
000110 dfda                      		rcall	USART_Transmit	; Transmit Ready Signal
000111 ef0f                      		ldi		mpr, SendReady
000112 9300 00ce                 		sts		UDR1, mpr
                                 		
                                 RECEIVE:
000114 dfdb                      		rcall	USART_Receive	; Check if both boards are ready
000115 3f0f                      		cpi		mpr, SendReady	; Checks if both boards send same ready signal
000116 f009                      		breq	BOTH_READY		; Branches if both boards are ready
000117 cffc                      		rjmp	RECEIVE			; Keeps Checking for Signal
                                 
                                 BOTH_READY:
000118 dfbe                      		rcall	DisplayGame		; Displays Game screen
                                 	
                                 SELECTS:
000119 e001                      		ldi		mpr, 0b0000_0001	; Clears any interrupt queues
00011a bb0c                      		out		EIFR, mpr
00011b 9478                      		sei							; Turns on interrupts
00011c dfda                      		rcall	LED_Count			; Counts for 6 seconds
00011d 94f8                      		cli							; Turn off interrupts
                                 
00011e dfcc                      		rcall	USART_Transmit		; Handshakes with other board to check if synced
00011f ef0f                      		ldi		mpr, SendReady
000120 9300 00ce                 		sts		UDR1, mpr
                                 
                                 SELECT:
000122 dfcd                      		rcall	USART_Receive
000123 3f0f                      		cpi		mpr, SendReady
000124 f009                      		breq	BOTH_SELECT
000125 cffc                      		rjmp	SELECT
                                 
                                 BOTH_SELECT:
000126 dfc4                      		rcall	USART_Transmit		; When boards are synced, send RPS choice
000127 2f02                      		mov		mpr, choice
000128 9300 00ce                 		sts		UDR1, mpr
                                 
00012a dfc5                      		rcall	USART_Receive		; Receive other boards choice 
00012b 3000                      		cpi		mpr, 0				; Opponent's choice is Rock
00012c f019                      		breq	OPP_ROCK
00012d 3001                      		cpi		mpr, 1				; Opponent's choice is Paper
00012e f041                      		breq	OPP_PAPER			
00012f c00e                      		rjmp	OPP_SCISSORS		; Opponent's choice is Scissors
                                 
                                 OPP_ROCK:
000130 d06f                      		rcall	DisplayRock1		; Displays Rock as opponent's choice
000131 dfc5                      		rcall	LED_Count			; Counts for 6 seconds
000132 1720                      		cp		choice, mpr			; Compares both inputs to determine tie
000133 f0a9                      		breq	TIE					
000134 3021                      		cpi		choice, 1			; Checks if user's input beats rock (Paper)
000135 f079                      		breq	WIN
000136 c010                      		rjmp	LOSE
                                 
                                 OPP_PAPER:
000137 d090                      		rcall	DisplayPaper1		; Displays Paper as opponent's choice
000138 dfbe                      		rcall	LED_Count			; Counts for 6 seconds
000139 1720                      		cp		choice, mpr			; Compares both inputs to determine tie
00013a f071                      		breq	TIE
00013b 3022                      		cpi		choice, 2			; Checks if user's input beats paper (Scissors)
00013c f041                      		breq	WIN
00013d c009                      		rjmp	LOSE
                                 
                                 OPP_SCISSORS:
00013e d0b1                      		rcall	DisplayScissors1	; Displays Scissors as opponent's choice
00013f dfb7                      		rcall	LED_Count			; Counts for 6 seconds
000140 1720                      		cp		choice, mpr			; Compares both inputs to determine tie
000141 f039                      		breq	TIE
000142 3020                      		cpi		choice, 0			; Checks if user's input beats Scissors (Rock)
000143 f009                      		breq	WIN
000144 c002                      		rjmp	LOSE
                                 
                                 WIN:
000145 d00a                      		rcall	DisplayWin			; Display Win screen
000146 c004                      		rjmp	RESET
                                 
                                 LOSE:	
000147 d01c                      		rcall	DisplayLose			; Display Lose screen
000148 c002                      		rjmp	RESET
                                 
                                 TIE:
000149 d02e                      		rcall	DisplayTie			; Display Tie screen
00014a c000                      		rjmp	RESET
                                 
                                 RESET:
00014b 910f                      		pop		mpr					; Goes back to Main function
00014c bf0f                      		out		SREG, mpr
00014d 910f                      		pop		mpr
00014e dfa8                      		rcall	LED_Count			; Counts for 6 seconds
00014f 9508                      		ret
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	DisplayWin
                                 ; Desc:	Displays "You won!" on first line of LCD
                                 ;		
                                 ;----------------------------------------------------------------
                                 DisplayWin:
000150 930f                      		push	mpr			; Save mpr register
000151 b70f                      		in		mpr, SREG	; Save program state
000152 930f                      		push	mpr		
000153 931f                      		push	mpr2
                                 
000154 d165                      		rcall	CLRDM1
000155 ece0                      		ldi		ZL, low(WON_STRING<<1)		; Gets address of lower string and stores to pointer Z
000156 e0f4                      		ldi		ZH, high(WON_STRING<<1)		; Gets address of higher string and stores to pointer Z
000157 e0a0                      		ldi		XL, low($0100)				; Gets address of lower 0100 data stores to pointer X for first line of LCD
000158 e0b1                      		ldi		XH, high($0100)				; Gets address of higher 0100 data stores to pointer X for first line of LCD
                                 
000159 e130                      		ldi		i, 16						; Sets loop number
                                 
                                 LOOP7:
00015a 9105                      		lpm		mpr, z+						; Sends Z data into mpr register
00015b 930d                      		st		X+, mpr						; Sends mpr data into X pointer then increases address by 1
00015c 953a                      		dec		i							; Decrements i
00015d f7e1                      		brne	LOOP7						; Keeps going though loop till i is 0
                                 		
00015e d142                      		rcall	LCDWrLn1					; Data onto LCD line 1 because of address
                                 
00015f 911f                      		pop		mpr2
000160 910f                      		pop		mpr
000161 bf0f                      		out		SREG, mpr
000162 910f                      		pop		mpr
                                 
000163 9508                      		ret
                                 
