0000e9 923f                      		push 	A				; Save A register
0000ea 924f                      		push	B				; Save B register
0000eb 921f                      		push	rhi				; Save rhi register
0000ec 920f                      		push	rlo				; Save rlo register
0000ed 922f                      		push	zero			; Save zero register
0000ee 93bf                      		push	XH				; Save X-ptr
0000ef 93af                      		push	XL
0000f0 93df                      		push	YH				; Save Y-ptr
0000f1 93cf                      		push	YL
0000f2 93ff                      		push	ZH				; Save Z-ptr
0000f3 93ef                      		push	ZL
