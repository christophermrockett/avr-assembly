0000ac 9309                      		st		y+, mpr	; Store low byte of D to low address
0000ad 9104                      		lpm		mpr, z	; Load high byte of D to mpr
0000ae 8308                      		st		y, mpr	; Store high byte of D to high address
                                 
0000af 910f                      		pop		mpr							; Pops old mpr value
0000b0 bf0f                      		out		SREG, mpr					; Restores old SREG value
