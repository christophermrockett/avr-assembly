0000b3 930f                      		push	mpr			; Save mpr register
0000b4 b70f                      		in		mpr, SREG	; Save program state
0000b5 930f                      		push	mpr			;		; Execute the function here
0000b6 933f                      		push	mpr2		; Save mpr2 register
                                 	
                                 		; Load beginning address of first operand into X
0000b7 e3a0                      		ldi		XL, low(SUB16_OP1)	; Load low byte of address
0000b8 e0b1                      		ldi		XH, high(SUB16_OP1)	; Load high byte of address
                                 
                                 		; Load beginning address of second operand into Y
0000b9 e3c2                      		ldi		YL, low(SUB16_OP2)	; Load low byte of address
0000ba e0d1                      		ldi		YH, high(SUB16_OP2)	; Load high byte of address
                                 
                                 		; Load beginning address of result into Z
0000bb e4e0                      		ldi		ZL, low(SUB16_Result) ; Load low byte of address
0000bc e0f1                      		ldi		ZH, high(SUB16_Result) ; Load high byte of address
                                 
                                 		; Execute the function here
0000bd 910d                      		ld		mpr, x+ ; load x LSB low value to mpr register
0000be 9139                      		ld		mpr2, y+ ; load y LSB low value to mpr2 register
0000bf 1b03                      		sub		mpr, mpr2 ; subtract x and y values and send to mpr register
0000c0 9301                      		st		z+, mpr ; store subtraction result to z address
0000c1 910c                      		ld		mpr, x ; load x high value and send to mpr register
0000c2 8138                      		ld		mpr2, y ; load y high value and send to mpr register
0000c3 0b03                      		sbc		mpr, mpr2 ; subtract values with carry and send to mpr
0000c4 9301                      		st		z+, mpr ; stores subtraction result to increased z address
                                 
0000c5 913f                      		pop		mpr2
0000c6 910f                      		pop		mpr							; Pops old mpr value
0000c7 bf0f                      		out		SREG, mpr					; Restores old SREG value
0000c8 910f                      		pop		mpr							; Pops old mpr value
                                 
0000c9 9508                      		ret						; End a function with RET
                                 
