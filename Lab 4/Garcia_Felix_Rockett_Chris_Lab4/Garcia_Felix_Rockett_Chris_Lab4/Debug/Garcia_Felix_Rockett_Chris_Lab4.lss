                                 ; Func: MUL16
                                 ; Desc: An example function that multiplies two 16-bit numbers
                                 ;       A - Operand A is gathered from address $0101:$0100
                                 ;       B - Operand B is gathered from address $0103:$0102
                                 ;       Res - Result is stored in address
                                 ;             $0107:$0106:$0105:$0104
                                 ;       You will need to make sure that Res is cleared before
                                 ;       calling this function.
                                 ;-----------------------------------------------------------
                                 MUL16:
000169 923f                      		push 	A				; Save A register
00016a 924f                      		push	B				; Save B register
00016b 921f                      		push	rhi				; Save rhi register
00016c 920f                      		push	rlo				; Save rlo register
00016d 922f                      		push	zero			; Save zero register
00016e 93bf                      		push	XH				; Save X-ptr
00016f 93af                      		push	XL
000170 93df                      		push	YH				; Save Y-ptr
000171 93cf                      		push	YL
000172 93ff                      		push	ZH				; Save Z-ptr
000173 93ef                      		push	ZL
000174 931f                      		push	oloop			; Save counters
000175 932f                      		push	iloop
                                 
000176 2422                      		clr		zero			; Maintain zero semantics
                                 
                                 		; Set Y to beginning address of B
000177 e0c2                      		ldi		YL, low(addrB)	; Load low byte
000178 e0d1                      		ldi		YH, high(addrB)	; Load high byte
                                 
