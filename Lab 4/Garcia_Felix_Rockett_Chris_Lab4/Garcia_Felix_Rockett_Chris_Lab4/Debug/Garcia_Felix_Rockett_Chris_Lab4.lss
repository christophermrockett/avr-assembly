                                 MUL16_OLOOP:
                                 		; Set X to beginning address of A
00017c e0a0                      		ldi		XL, low(addrA)	; Load low byte
00017d e0b1                      		ldi		XH, high(addrA)	; Load high byte
                                 
                                 		; Begin inner for loop
00017e e022                      		ldi		iloop, 2		; Load counter
                                 MUL16_ILOOP:
00017f 903d                      		ld		A, X+			; Get byte of A operand
000180 8048                      		ld		B, Y			; Get byte of B operand
000181 9c34                      		mul		A,B				; Multiply A and B
000182 9031                      		ld		A, Z+			; Get a result byte from memory
000183 9041                      		ld		B, Z+			; Get the next result byte from memory
000184 0c03                      		add		rlo, A			; rlo <= rlo + A
000185 1c14                      		adc		rhi, B			; rhi <= rhi + B + carry
000186 8030                      		ld		A, Z			; Get a third byte from the result
000187 1c32                      		adc		A, zero			; Add carry to A
000188 8230                      		st		Z, A			; Store third byte to memory
000189 9212                      		st		-Z, rhi			; Store second byte to memory
00018a 9202                      		st		-Z, rlo			; Store first byte to memory
00018b 9631                      		adiw	ZH:ZL, 1		; Z <= Z + 1
00018c 952a                      		dec		iloop			; Decrement counter
00018d f789                      		brne	MUL16_ILOOP		; Loop if iLoop != 0
                                 		; End inner for loop
                                 
00018e 9731                      		sbiw	ZH:ZL, 1		; Z <= Z - 1
00018f 9621                      		adiw	YH:YL, 1		; Y <= Y + 1
000190 951a                      		dec		oloop			; Decrement counter
000191 f751                      		brne	MUL16_OLOOP		; Loop if oLoop != 0
                                 		; End outer for loop
                                 
000192 912f                      		pop		iloop			; Restore all registers in reverves order
000193 911f                      		pop		oloop
000194 91ef                      		pop		ZL
000195 91ff                      		pop		ZH
000196 91cf                      		pop		YL
000197 91df                      		pop		YH
000198 91af                      		pop		XL
000199 91bf                      		pop		XH
00019a 902f                      		pop		zero
00019b 900f                      		pop		rlo
00019c 901f                      		pop		rhi
00019d 904f                      		pop		B
00019e 903f                      		pop		A
00019f 9508                      		ret						; End a function with RET
                                 
