                                 .include "m128def.inc"			; Include definition file
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega128.xml ***********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m128def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega128
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega128
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M128DEF_INC_
                                 #endif  /* _M128DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;***********************************************************
                                 ;*	Internal Register Definitions and Constants
                                 ;***********************************************************
                                 .def	mpr = r16				; Multipurpose register
                                 .def	mpr2 = r19
                                 .def	rlo = r0				; Low byte of MUL result
                                 .def	rhi = r1				; High byte of MUL result
                                 .def	zero = r2				; Zero register, set to zero in INIT, useful for calculations
                                 .def	A = r3					; A variable
                                 .def	B = r4					; Another variable
                                 
                                 .def	oloop = r17				; Outer Loop Counter
                                 .def	iloop = r18				; Inner Loop Counter
                                 
                                 
                                 ;***********************************************************
                                 ;*	Start of Code Segment
                                 ;***********************************************************
                                 .cseg							; Beginning of code segment
                                 
                                 ;-----------------------------------------------------------
                                 ; Interrupt Vectors
                                 ;-----------------------------------------------------------
                                 .org	$0000					; Beginning of IVs
000000 c055                      		rjmp 	INIT			; Reset interrupt
                                 
                                 .org	$0056					; End of Interrupt Vectors
                                 
                                 ;-----------------------------------------------------------
                                 ; Program Initialization
                                 ;-----------------------------------------------------------
                                 INIT:							; The initialization routine
                                 
                                 		; Initialize Stack Pointer
000056 ef0f                      		ldi		mpr, low(RAMEND)
000057 bf0d                      		out		SPL, mpr		; Load SPL with low byte of RAMEND
000058 e100                      		ldi		mpr, high(RAMEND)
000059 bf0e                      		out		SPH, mpr		; Load SPH with high byte of RAMEND
                                 		; TODO
                                 
00005a 2422                      		clr		zero			; Set the zero register to zero, maintain
                                 										; these semantics, meaning, don't
                                 										; load anything else into it.
                                 
                                 ;-----------------------------------------------------------
                                 ; Main Program
                                 ;-----------------------------------------------------------
                                 MAIN:							; The Main program
                                 
00005b d010                      		rcall ADDLoad ; Call function to load ADD16 operands
00005c 0000                      		nop ; Check load ADD16 operands (Set Break point here #1)
                                 
                                 		; Call ADD16 function to display its results (calculate FCBA + FFFF) = 01FCB9
00005d d025                      		rcall ADD16
00005e 0000                      		nop ; Check ADD16 result (Set Break point here #2)
                                 
                                 
00005f d03c                      		rcall SUBLoad ; Call function to load SUB16 operands
000060 0000                      		nop ; Check load SUB16 operands (Set Break point here #3)
                                 
000061 d051                      		rcall SUB16 ; Call SUB16 function to display its results (calculate FCB9 - E420) = 1899
000062 0000                      		nop ; Check SUB16 result (Set Break point here #4)
                                 
                                 
000063 d066                      		rcall MULLoad; Call function to load MUL24 operands
000064 0000                      		nop ; Check load MUL24 operands (Set Break point here #5)
                                 
000065 d083                      		rcall MUL24; Call MUL24 function to display its results (calculate FFFFFF * FFFFFF) = FFFFFE000001
000066 0000                      		nop ; Check MUL24 result (Set Break point here #6)
                                 
000067 d0ba                      		rcall COMPOUNDLoad; Setup the COMPOUND function direct test
000068 0000                      		nop ; Check load COMPOUND operands (Set Break point here #7)
                                 
000069 d0d1                      		rcall COMPOUND; Call the COMPOUND function (calculate FE53^2 = FCA8CEE9)
00006a 0000                      		nop ; Check COMPOUND result (Set Break point here #8)
                                 
00006b cfff                      DONE:	rjmp	DONE			; Create an infinite while loop to signify the
                                 								; end of the program.
                                 
                                 ;***********************************************************
                                 ;*	Functions and Subroutines
                                 ;***********************************************************
                                 
                                 ;-----------------------------------------------------------
                                 ; Func: ADD16
                                 ; Desc: Adds two 16-bit numbers and generates a 24-bit number
                                 ;       where the high byte of the result contains the carry
                                 ;       out bit.
                                 ;-----------------------------------------------------------
                                 ADDLoad:
00006c 930f                      		push	mpr			; Save mpr register
00006d b70f                      		in		mpr, SREG	; Save program state
00006e 930f                      		push	mpr			;		
                                 		; Execute the function here
                                 
00006f e4e2                      		ldi		ZL, low(OperandA<<1)	; Load low byte of address
000070 e0f3                      		ldi		ZH, high(OperandA<<1)	; Load high byte of address
                                 
                                 		; Load beginning address of second operand into Y
000071 e1c0                      		ldi		YL, low(ADD16_OP1)	; Load low byte of address
000072 e0d1                      		ldi		YH, high(ADD16_OP1)	; Load high byte of address
                                 
000073 9105                      		lpm		mpr, z+	; Load low byte of A to mpr
000074 9309                      		st		y+, mpr	; Store low byte of A to OP1 low address
000075 9104                      		lpm		mpr, z	; Load high byte of A to mpr
000076 8308                      		st		y, mpr	; Store high byte of A to OP1 high address
                                 
000077 e4e4                      		ldi		ZL, low(OperandB<<1)	; Load low byte of address
000078 e0f3                      		ldi		ZH, high(OperandB<<1)	; Load high byte of address
                                 
                                 		; Load beginning address of second operand into Y
000079 e1c2                      		ldi		YL, low(ADD16_OP2)	; Load low byte of address
00007a e0d1                      		ldi		YH, high(ADD16_OP2)	; Load high byte of address
                                 
00007b 9105                      		lpm		mpr, z+	; Load low byte of B to mpr
00007c 9309                      		st		y+, mpr	; Store low byte of B to OP2 low address
00007d 9104                      		lpm		mpr, z	; Load high byte of B to mpr
00007e 8308                      		st		y, mpr	; Store high byte of B to OP2 high address
                                 
00007f 910f                      		pop		mpr							; Pops old mpr value
000080 bf0f                      		out		SREG, mpr					; Restores old SREG value
000081 910f                      		pop		mpr							; Pops old mpr value
                                 
000082 9508                      		ret
                                 
                                 ADD16:
000083 930f                      		push	mpr			; Save mpr register
000084 b70f                      		in		mpr, SREG	; Save program state
000085 930f                      		push	mpr					
000086 933f                      		push	mpr2		; Save mpr2 register
                                 
                                 		; Load beginning address of first operand into X
000087 e1a0                      		ldi		XL, low(ADD16_OP1)	; Load low byte of address
000088 e0b1                      		ldi		XH, high(ADD16_OP1)	; Load high byte of address
                                 
                                 		; Load beginning address of second operand into Y
000089 e1c2                      		ldi		YL, low(ADD16_OP2)	; Load low byte of address
00008a e0d1                      		ldi		YH, high(ADD16_OP2)	; Load high byte of address
                                 
                                 		; Load beginning address of result into Z
00008b e2e0                      		ldi		ZL, low(ADD16_Result) ; Load low byte of address
00008c e0f1                      		ldi		ZH, high(ADD16_Result) ; Load high byte of address
                                 
                                 		; Execute the function
00008d 910d                      		ld		mpr, x+ ; load x LSB low value to mpr register
00008e 9139                      		ld		mpr2, y+ ; load y LSB low value to mpr2 register
00008f 0f30                      		add		mpr2, mpr ; add x and y values and send to mpr2 register
000090 9331                      		st		z+, mpr2 ; store addition result to z address
000091 910c                      		ld		mpr, x ; load x high value and send to mpr register
000092 8138                      		ld		mpr2, y ; load y high value and send to mpr register
000093 1f30                      		adc		mpr2, mpr ; add values with carry
000094 9331                      		st		z+, mpr2 ; stores addition result to increased z address
