                                 .equ	OC4Daddr	= 0x0050	; Timer/Counter4 Compare Match D
                                 .equ	OVF4addr	= 0x0052	; Timer/Counter4 Overflow
                                 .equ	TIMER4_FPFaddr	= 0x0054	; Timer/Counter4 Fault Protection Interrupt
                                 
                                 .equ	INT_VECTORS_SIZE	= 86	; size in words
                                 
                                 #endif  /* _M32U4DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;*	This is the skeleton file for Lab 5 of ECE 375
                                 ;*
                                 ;*	 Author: Chris Rockett
                                 ;*	   Date: 2/11/2026
                                 ;*
                                 ;***********************************************************
                                 
                                 .include "m32U4def.inc"			; Include definition file
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega32U4.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m32U4def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega32U4
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega32U4
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M32U4DEF_INC_
                                 #endif  /* _M32U4DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;***********************************************************
                                 ;*	Internal Register Definitions and Constants
                                 ;***********************************************************
                                 .def	mpr = r16				; Multipurpose register
                                 .def	waitcnt = r17			; Wait Loop Counter
                                 .def	ilcnt = r18				; Inner Loop Counter
                                 .def	olcnt = r19				; Outer Loop Counter
                                 .def	i = r23					; i variable for loops
                                 .def	LCNT = r24				; Left counter
                                 .def	RCNT = r25				; Right counter
                                 
                                 .equ	WTime = 100				; Time to wait in wait loop (1 second)
                                 
                                 .equ	WskrR = 0				; Right Whisker Input Bit
                                 .equ	WskrL = 1				; Left Whisker Input Bit
                                 .equ	ButtClr = 3				; Clear Button Input
                                 .equ	EngEnR = 5				; Right Engine Enable Bit
                                 .equ	EngEnL = 6				; Left Engine Enable Bit
                                 .equ	EngDirR = 4				; Right Engine Direction Bit
                                 .equ	EngDirL = 7				; Left Engine Direction Bit
                                 
                                 ;/////////////////////////////////////////////////////////////
                                 ;These macros are the values to make the TekBot Move.
                                 ;/////////////////////////////////////////////////////////////
                                 
                                 .equ	MovFwd = (1<<EngDirR|1<<EngDirL)	; Move Forward Command
                                 .equ	MovBck = $00				; Move Backward Command
                                 .equ	TurnR = (1<<EngDirL)			; Turn Right Command
                                 .equ	TurnL = (1<<EngDirR)			; Turn Left Command
                                 .equ	Halt = (1<<EngEnR|1<<EngEnL)		; Halt Command
                                 
                                 ;***********************************************************
                                 ;*	Start of Code Segment
                                 ;***********************************************************
                                 .cseg							; Beginning of code segment
                                 
                                 ;***********************************************************
                                 ;*	Interrupt Vectors
                                 ;***********************************************************
                                 .org	$0000					; Beginning of IVs
000000 c055                      		rjmp 	INIT			; Reset interrupt
                                 
                                 .org	$0002					; INT0 interrupt (Right whisker hit)
000002 d089                      		rcall	HitRight		; Goes through right whisker hit procedure
000003 9518                      		reti
                                 
                                 .org	$0004					; INT1 interrupt (Left whisker hit)
000004 d0a2                      		rcall	HitLeft			; Goes through left whisker hit procedure
000005 9518                      		reti
                                 
                                 .org	$0008					; INT3 interrupt (Clear button hit)
000008 d0b9                      		rcall	Clear			; Resets left and right counters and display
000009 9518                      		reti
                                 
                                 .org	$0056					; End of Interrupt Vectors
                                 
                                 ;***********************************************************
                                 ;*	Program Initialization
                                 ;***********************************************************
                                 INIT:							; The initialization routine
                                 		; Initialize Stack Pointer
000056 ef0f                      		ldi		mpr, low(RAMEND)
000057 bf0d                      		out		SPL, mpr		; Load SPL with low byte of RAMEND
000058 e00a                      		ldi		mpr, high(RAMEND)
000059 bf0e                      		out		SPH, mpr		; Load SPH with high byte of RAMEND
                                 
                                 		; Initialize Port B for output
00005a ef0f                      		ldi		mpr, $FF		; Set Port B Data Direction Register
00005b b904                      		out		DDRB, mpr		; for output
00005c e000                      		ldi		mpr, $00		; Initialize Port B Data Register
00005d b905                      		out		PORTB, mpr		; so all Port B outputs are low
                                 
                                 		; Initialize Port D for input
00005e e000                      		ldi		mpr, $00		; Set Port D Data Direction Register
00005f b90a                      		out		DDRD, mpr		; for input
000060 ef0f                      		ldi		mpr, $FF		; Initialize Port D Data Register
000061 b90b                      		out		PORTD, mpr		; so all Port D inputs are Tri-State
                                 
                                 		; Initialize LCD Display
000062 d083                      		rcall	LCDInit			; Initializes LCD
000063 d0c1                      		rcall	LCDClr			; Clears dots on LCD
000064 d00b                      		rcall	DisplayName		; Displays the initial count (0) on display
                                 
                                 		; Initialize external interrupts
000065 e80a                      		ldi		mpr, 0b1000_1010	; Sets intterupts INT0, INT1, and INT3 to falling edge (10)
000066 9300 0069                 		sts		EICRA, mpr
                                 
                                 		; Configure the External Interrupt Mask
000068 e00b                      		ldi		mpr, 0b0000_1011	; Configures interrupts INT0, INT1, and INT3
000069 bb0d                      		out		EIMSK, mpr
                                 
                                 		; Initialize Count variables to 0
00006a e080                      		ldi LCNT, 0			
00006b e090                      		ldi RCNT, 0
                                 
                                 		; Turn on interrupts
                                 			; NOTE: This must be the last thing to do in the INIT function
00006c 9478                      		sei
                                 
                                 ;***********************************************************
                                 ;*	Main Program
                                 ;***********************************************************
                                 MAIN:							; The Main program
                                 
00006d e900                      		ldi		mpr, MovFwd		; Load Move Forward Command
00006e b905                      		out		PORTB, mpr		; Send command to motors
00006f cffd                      		rjmp	MAIN			; Create an infinite while loop to signify the
                                 								; end of the program.
                                 
                                 ;***********************************************************
                                 ;*	Functions and Subroutines
                                 ;***********************************************************
                                 ;----------------------------------------------------------------
                                 ; Sub:	HitRight
                                 ; Desc:	Handles functionality of the TekBot when the right whisker
                                 ;		is triggered.
                                 ;----------------------------------------------------------------
                                 DisplayName:
                                 		; Save variables by pushing them to the stack
000070 930f                      		push	mpr			; Save mpr register
000071 931f                      		push	waitcnt			; Save wait register
000072 b70f                      		in		mpr, SREG	; Save program state
000073 930f                      		push	mpr			;		; Execute the function here
                                 
000074 ebe0                      		ldi		ZL, low(COUNT_LEFT<<1)		; Gets address of lower COUNT_LEFT data stores to pointer Z
000075 e0f1                      		ldi		ZH, high(COUNT_LEFT<<1)		; Gets address of higher COUNT_LEFT data stores to pointer Z
000076 e0c0                      		ldi		YL, low($0100)				; Gets address of lower 0100 data stores to pointer Y for first line of LCD
000077 e0d1                      		ldi		YH, high($0100)				; Gets address of higher 0100 data stores to pointer Y for first line of LCD
                                 
000078 e07e                      		ldi		i, 14						; Sets loop number equal to characters in COUNT_LEFT
                                 
                                 LOOPD:
000079 9105                      		lpm		mpr, z+						; Sends Z data into mpr register
00007a 9309                      		st		Y+, mpr						; Sends mpr data into Y pointer then increases address by 1
00007b 957a                      		dec		i							; Decrements i
00007c f7e1                      		brne	LOOPD						; Keeps going though loop till i is 0
                                 
00007d e1c0                      		ldi		YL, low($0110)				; Initializes Y pointer address to beginning of second line
00007e e0d1                      		ldi		YH, high($0110)
00007f ebee                      		ldi		ZL, low(COUNT_RIGHT<<1)		; Gets address of lower COUNT_RIGHT data stores to pointer Z
000080 e0f1                      		ldi		ZH, high(COUNT_RIGHT<<1)		; Gets address of COUNT_RIGHT data stores to pointer Z
                                 
                                 
                                 
000081 e07e                      		ldi		i, 14						; Sets loop number equal to characters in COUNT_RIGHT
                                 LOOPD2:
000082 9105                      		lpm		mpr, z+						; Sends new x data to mpr register
000083 9309                      		st		Y+, mpr						; mpr data stored into Y pointer then increases
000084 957a                      		dec		i							; Decrements i
000085 f7e1                      		brne	LOOPD2						; Keeps going through loop till i is 0
                                 		
000086 d085                      		rcall	LCDWrite					; X and Y data onto LCD because of their addresses
                                 
                                 		
                                 		; Restore variables by popping them from the stack,
                                 		; in reverse order
000087 910f                      		pop		mpr							; Pops old mpr value
000088 bf0f                      		out		SREG, mpr					; Restores old SREG value
000089 911f                      		pop		waitcnt						; Pops old waitcnt value
00008a 910f                      		pop		mpr							; Pops old mpr value
                                 
00008b 9508                      		ret						; End a function with RET
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	HitRight
                                 ; Desc:	Handles functionality of the TekBot when the right whisker
                                 ;		is triggered.
                                 ;----------------------------------------------------------------
                                 
                                 HitRight:
00008c 930f                      		push	mpr			; Save mpr register
00008d 931f                      		push	waitcnt			; Save wait register
00008e b70f                      		in		mpr, SREG	; Save program state
00008f 930f                      		push	mpr			;
                                 
000090 e1ad                      		ldi		XL, low($011D)				; Gets address of lower 010D data stores to pointer Y for first line of LCD
000091 e0b1                      		ldi		XH, high($011D)				; Gets address of higher 010D data stores to pointer Y for first line of LCD
                                 
000092 9593                      		inc		RCNT			; Increments Right Count
000093 2f09                      		mov		mpr, RCNT		; Copies value to mpr for Bin2ASCII function
000094 d0bf                      		rcall	Bin2ASCII		; Calls Bin2ASCII from LCDDriver file
000095 d076                      		rcall	LCDWrite		; Updates new number to LCD screen
                                 
                                 		; Move Backwards for a second
000096 e000                      		ldi		mpr, MovBck	; Load Move Backward command
000097 b905                      		out		PORTB, mpr	; Send command to port
000098 e614                      		ldi		waitcnt, WTime	; Wait for 1 second
000099 d02f                      		rcall	Wait			; Call wait function
                                 
                                 		; Turn left for a second
00009a e100                      		ldi		mpr, TurnL	; Load Turn Left Command
00009b b905                      		out		PORTB, mpr	; Send command to port
00009c e614                      		ldi		waitcnt, WTime	; Wait for 1 second
00009d d02b                      		rcall	Wait			; Call wait function
                                 
                                 		; Move Forward again
00009e e900                      		ldi		mpr, MovFwd	; Load Move Forward command
00009f b905                      		out		PORTB, mpr	; Send command to port
                                 
0000a0 e00b                      		ldi		mpr, 0b0000_1011	; Clears any interrupt queues
0000a1 bb0c                      		out		EIFR, mpr
                                 
0000a2 910f                      		pop		mpr		; Restore program state
0000a3 bf0f                      		out		SREG, mpr	;
0000a4 911f                      		pop		waitcnt		; Restore wait register
0000a5 910f                      		pop		mpr		; Restore mpr
0000a6 9508                      		ret				; Return from subroutine
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	HitLeft
                                 ; Desc:	Handles functionality of the TekBot when the left whisker
                                 ;		is triggered.
                                 ;----------------------------------------------------------------
                                 HitLeft:
0000a7 930f                      		push	mpr			; Save mpr register
0000a8 931f                      		push	waitcnt			; Save wait register
0000a9 b70f                      		in		mpr, SREG	; Save program state
0000aa 930f                      		push	mpr			;
                                 
0000ab e0ac                      		ldi		XL, low($010C)				; Gets address of lower 010C data stores to pointer Y for first line of LCD
0000ac e0b1                      		ldi		XH, high($010C)				; Gets address of higher 010C data stores to pointer Y for first line of LCD
                                 
0000ad 9583                      		inc		LCNT		; Increments Left Count
0000ae 2f08                      		mov		mpr, LCNT	; Copies value to mpr for Bin2ASCII function
0000af d0a4                      		rcall	Bin2ASCII	; Calls Bin2ASCII from LCDDriver file
0000b0 d05b                      		rcall	LCDWrite	; Updates new number to LCD screen
                                 
                                 		; Move Backwards for a second
0000b1 e000                      		ldi		mpr, MovBck	; Load Move Backward command
0000b2 b905                      		out		PORTB, mpr	; Send command to port
0000b3 e614                      		ldi		waitcnt, WTime	; Wait for 1 second
0000b4 d014                      		rcall	Wait			; Call wait function
                                 
                                 		; Turn right for a second
0000b5 e800                      		ldi		mpr, TurnR	; Load Turn Left Command
0000b6 b905                      		out		PORTB, mpr	; Send command to port
0000b7 e614                      		ldi		waitcnt, WTime	; Wait for 1 second
0000b8 d010                      		rcall	Wait			; Call wait function
                                 
                                 		; Move Forward again
0000b9 e900                      		ldi		mpr, MovFwd	; Load Move Forward command
0000ba b905                      		out		PORTB, mpr	; Send command to port
                                 
0000bb e00b                      		ldi		mpr, 0b0000_1011	; Clears any interrupt queues
0000bc bb0c                      		out		EIFR, mpr
                                 
0000bd 910f                      		pop		mpr		; Restore program state
0000be bf0f                      		out		SREG, mpr	;
0000bf 911f                      		pop		waitcnt		; Restore wait register
0000c0 910f                      		pop		mpr		; Restore mpr
0000c1 9508                      		ret				; Return from subroutine
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	Clear
                                 ; Desc:	Resets counter numbers and resets LCD display
                                 ;	
                                 ;----------------------------------------------------------------
                                 Clear:
0000c2 e080                      		ldi		LCNT, 0		; Resets counts to 0
0000c3 e090                      		ldi		RCNT, 0
                                 
0000c4 d060                      		rcall	LCDClr			; Resets LCD to display 0
0000c5 dfaa                      		rcall	DisplayName
                                 
0000c6 e00b                      		ldi		mpr, 0b0000_1011	; Clears any interrupt queues
0000c7 bb0c                      		out		EIFR, mpr
                                 
0000c8 9508                      		ret
                                 
                                 
                                 
                                 ;----------------------------------------------------------------
                                 ; Sub:	Wait
                                 ; Desc:	A wait loop that is 16 + 159975*waitcnt cycles or roughly
                                 ;		waitcnt*10ms.  Just initialize wait for the specific amount
                                 ;		of time in 10ms intervals. Here is the general eqaution
                                 ;		for the number of clock cycles in the wait loop:
                                 ;			(((((3*ilcnt)-1+4)*olcnt)-1+4)*waitcnt)-1+16
                                 ;----------------------------------------------------------------
                                 Wait:
0000c9 931f                      		push	waitcnt			; Save wait register
0000ca 932f                      		push	ilcnt			; Save ilcnt register
0000cb 933f                      		push	olcnt			; Save olcnt register
                                 
0000cc ee30                      Loop:	ldi		olcnt, 224		; load olcnt register
0000cd ee2d                      OLoop:	ldi		ilcnt, 237		; load ilcnt register
0000ce 952a                      ILoop:	dec		ilcnt			; decrement ilcnt
0000cf f7f1                      		brne	ILoop			; Continue Inner Loop
0000d0 953a                      		dec		olcnt		; decrement olcnt
0000d1 f7d9                      		brne	OLoop			; Continue Outer Loop
0000d2 951a                      		dec		waitcnt		; Decrement wait
0000d3 f7c1                      		brne	Loop			; Continue Wait loop
                                 
0000d4 913f                      		pop		olcnt		; Restore olcnt register
0000d5 912f                      		pop		ilcnt		; Restore ilcnt register
0000d6 911f                      		pop		waitcnt		; Restore wait register
0000d7 9508                      		ret				; Return from subroutine
                                 
                                 ;***********************************************************
                                 ;*	Stored Program Data
                                 ;***********************************************************
                                 
                                 COUNT_LEFT:
0000d8 654c
0000d9 7466
0000da 4320
0000db 756f
0000dc 746e
0000dd 203a
0000de 2030                      .DB		"Left Count: 0 "		; Declaring data in program memory
                                 COUNT_RIGHT:
0000df 6952
0000e0 6867
0000e1 2074
0000e2 6f43
0000e3 6e75
0000e4 3a74
0000e5 3020                      .DB		"Right Count: 0"
                                 
                                 ;***********************************************************
                                 ;*	Additional Program Includes
                                 ;***********************************************************
                                 .include "LCDDriver(1).asm"		; Include the LCD Driver
                                 
                                 ;*	Oregon State University
                                 ;*	ST7565R LCD Driver
                                 ;*	This code configures the graphical LCD and emulates
                                 ;*	the behavior of a 2x16 character display.
                                 ;*
                                 ;*	The LCD has room for 32 characters in total
                                 ;*	(16 on the top and 16 on the bottom).
                                 ;*	The upper 16 characters should be located in SRAM starting at 0x0100.
                                 ;*	The lower 16 characters should be located in SRAM starting at 0x0110.
                                 ;*
                                 ;*	NOTE: Register r16 MUST be named 'mpr' in the Main Code
                                 ;*	Something like this:
                                 ;*	.def	mpr = r16
                                 ;*
                                 ;*	WARNING: Register r20-r22 are reserved and cannot be
                                 ;*		renamed outside of the LCD Driver functions. Doing
                                 ;*		so will damage the functionality of the LCD Driver
                                 ;*
                                 ;*	Acknowledgements: the Bin2ASCII and div10 procedures were written by
                                 ;*	David Zier for a previous board. The code has been retained intact.
                                 ;*
                                 ;*********************************************************************
                                 ;*	Rev	Date		Name			Description
                                 ;*--------------------------------------------------------------------
                                 ;*	-	8/18/22	Justin Goins	Version 1.0
                                 ;*
                                 ;*
                                 ;*********************************************************************
                                 
                                 .include "m32U4def.inc"				; Include definition file
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega32U4.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m32U4def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega32U4
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega32U4
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M32U4DEF_INC_
                                 #endif  /* _M32U4DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Register definitions
                                 .def	count = r20			; Character Counter
                                 .def	q = r21			; Quotient for div10
                                 .def	r = r22			; Remander for div10
                                 
                                 ; The following constants are not intended to be modified.
                                 .equ	lcd_buffer_addr = 0x0100 ; define the SRAM base address of the LCD buffer
                                 
                                 ; This information is gathered from the ST7565R datasheet.
                                 ; define some command patterns
                                 .equ	lcd_c_disp_en = 0b10101110 ; lsb indicates whether the LCD is on (1) or off (0)
                                 .equ	lcd_c_disp_set_start_ln = 0b01000000 ; lower 6 bits indicate the line index (0 - 63)
                                 .equ	lcd_c_disp_set_page_addr = 0b10110000 ; lower 4 bits indicate the page address (page 3 is at top and page 0 is at bottom)
                                 ; together, these commands allow you to specify a column index from (0 - 131):
                                 .equ	lcd_c_disp_set_col_addr_h = 0b00010000 ; lower 4 bits indicate the 4 high bits of the column address
                                 .equ	lcd_c_disp_set_col_addr_l = 0b00000000 ; lower 4 bits indicate the 4 low bits of the column address
                                 .equ	lcd_c_disp_set_invert = 0b10100110 ; lsb indicates whether the LCD is normal (0) or inverted (1)
                                 .equ	lcd_c_disp_fill = 0b10100100 ; lsb indicates whether the LCD is normal (0) or filled with dots (1)
                                 .equ	lcd_c_disp_reset = 0b11100010 ; resets the line/page addresses and other stuff, does not affect data RAM
                                 .equ	lcd_c_disp_set_bias = 0xA2 ; 1/6 bias (in 1/33 duty mode)
                                 .equ	lcd_c_disp_set_scandir = 0b11000000 ; select normal scan direction (most significant bit is placed at top of LCD)
                                 .equ	lcd_c_disp_set_contrast_1 = 0b10000001 ; first we send this command then we pass the value
                                 .equ	lcd_c_disp_set_contrast_2 = 15 ; can select a contrast value between 1 and 63
                                 .equ	lcd_c_disp_set_res_ratio = 0x22 ; see the datasheet
                                 .equ	lcd_c_disp_vreg_on = 0x2F ; enable voltage booster, voltage regulator, and voltage follower
                                 
                                 ; use this command to write into the LCD RAM:
                                 .equ	lcd_c_disp_write = 0b00000000 ; these 8 bits are the data to be placed in the target. 
                                 ; note that the column address is automatically incremented by 1 after each write to the LCD data
                                 
                                 ; everything in this driver file needs to go into the code segment
                                 .cseg
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDInit
                                 ;* Desc:	This function initializes the LCD control pins and
                                 ;*		sets reasonable values for the configuration registers.
                                 ;*****************************************************************
                                 LCDInit:
0000e6 930f                      	push	mpr
                                 
                                 	; set MOSI, SCL, and SS as outputs
0000e7 9a22                      	sbi	DDRB, DDB2	; Port B 2
0000e8 9a21                      	sbi	DDRB, DDB1	; Port B 1
0000e9 9a20                      	sbi	DDRB, DDB0	; Port B 0
                                 	; ensure that SS is deactivated (active low)
0000ea 9a28                      	sbi	PORTB, 0
                                 	; set lcd_A0 as output
0000eb 9a81                      	sbi	DDRF, DDF1	; Port F 1
                                 	; enable LCD backlight control
0000ec 9a3f                      	sbi	DDRC, DDC7	; Port C 7
                                 	; set lcd_RST_N as output
0000ed 9a80                      	sbi	DDRF, DDF0	; Port F 0
                                 	; we pull lcd_RST_N low for 1 millisecond
0000ee 9888                      	cbi	PORTF, 0
0000ef 940e 01d1                 	call	LCDDelay
0000f1 9a88                      	sbi	PORTF, 0
                                 	; Enable SPI mode 3, master configuration, set clock rate fck/2 using SPI2X
0000f2 e50c                      	ldi	mpr, (1<<SPE)|(1<<MSTR)|(1<<CPOL)|(1<<CPHA)
0000f3 bd0c                      	out	SPCR, mpr
0000f4 e001                      	ldi	mpr, (1<<SPI2X)
0000f5 bd0d                      	out	SPSR, mpr
                                 	; Note: after transmitting a byte, the SPI interrupt flag will
                                 	; be automatically cleared next time we: 1) read SPSR and ALSO 2) access SPDR
                                 
0000f6 9828                      	cbi	PORTB, 0	; activate slave select
                                 	; send a string of initialization commands
0000f7 ea02                      	ldi	mpr, lcd_c_disp_set_bias
0000f8 d0d2                      	rcall	LCD_Internal_WriteCMD
0000f9 ec00                      	ldi	mpr, lcd_c_disp_set_scandir
0000fa d0d0                      	rcall	LCD_Internal_WriteCMD
0000fb e801                      	ldi	mpr, lcd_c_disp_set_contrast_1
0000fc d0ce                      	rcall	LCD_Internal_WriteCMD
0000fd e00f                      	ldi	mpr, lcd_c_disp_set_contrast_2
0000fe d0cc                      	rcall	LCD_Internal_WriteCMD
0000ff e202                      	ldi	mpr, lcd_c_disp_set_res_ratio
000100 d0ca                      	rcall	LCD_Internal_WriteCMD
000101 e20f                      	ldi	mpr, lcd_c_disp_vreg_on
000102 d0c8                      	rcall	LCD_Internal_WriteCMD
000103 ea0f                      	ldi	mpr, (lcd_c_disp_en | 1 << 0)
000104 d0c6                      	rcall	LCD_Internal_WriteCMD
000105 9a28                      	sbi	PORTB, 0	; deactivate slave select
                                 
000106 910f                      	pop	mpr
000107 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDBacklightOn
                                 ;* Desc:	Enables the backlight
                                 ;*****************************************************************
                                 LCDBacklightOn:
000108 9a47                      	sbi	PORTC, 7
000109 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDBacklightOff
                                 ;* Desc:	Disables the backlight
                                 ;*****************************************************************
                                 LCDBacklightOff:
00010a 9847                      	cbi	PORTC, 7
00010b 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDWrite
                                 ;* Desc:	This function writes 32 characters to the LCD screen...
                                 ;*		16 chars on the top line and 16 chars on the bottom line.
                                 ;*****************************************************************
                                 LCDWrite:
00010c d002                      	rcall	LCDWrLn1
00010d d00c                      	rcall	LCDWrLn2
00010e 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDWrLn1
                                 ;* Desc:	This function writes 16 characters to the top line.
                                 ;*****************************************************************
                                 LCDWrLn1:
00010f 93bf                      	push	XH
000110 93af                      	push	XL
000111 931f                      	push	r17
                                 	; r17 specifies the destination bank in LCD RAM
000112 e013                      	ldi	r17, 3
                                 	; point X at the ASCII data
000113 e0b1                      	ldi	XH, HIGH(lcd_buffer_addr)
000114 e0a0                      	ldi	XL, LOW(lcd_buffer_addr)
000115 d05c                      	rcall	LCD_Internal_WriteLn
000116 911f                      	pop	r17
000117 91af                      	pop	XL
000118 91bf                      	pop	XH
000119 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDWrLn2
                                 ;* Desc:	This function writes 16 characters to the bottom line.
                                 ;*****************************************************************
                                 LCDWrLn2:
00011a 93bf                      	push	XH
00011b 93af                      	push	XL
00011c 931f                      	push	r17
                                 	; r17 specifies the destination bank in LCD RAM
00011d e011                      	ldi	r17, 1
                                 	; point X at the ASCII data
00011e e0b1                      	ldi	XH, HIGH(lcd_buffer_addr+16)
00011f e1a0                      	ldi	XL, LOW(lcd_buffer_addr+16)
000120 d051                      	rcall	LCD_Internal_WriteLn
000121 911f                      	pop	r17
000122 91af                      	pop	XL
000123 91bf                      	pop	XH
000124 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDClr
                                 ;* Desc:	This function clears the entire LCD screen.
                                 ;*****************************************************************
                                 LCDClr:
000125 d022                      	rcall	LCDClrLn1
000126 d027                      	rcall	LCDClrLn2
                                 
000127 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	CLRDM1
                                 ;* Desc:	This function clears Data Memory by writing 16 
                                 ;*		consecutive ASCII spaces $20 to the memory at $0100.
                                 ;*****************************************************************
                                 CLRDM1:
                                     ; Set X register points to $0100
000128 93bf                      	   push	   XH
000129 93af                      	   PUSH	   XL
00012a 930f                                 push    r16
00012b 931f                                 push    r17
                                 
00012c e0b1                                 ldi     XH, HIGH(lcd_buffer_addr)
00012d e0a0                                 ldi     XL, LOW(lcd_buffer_addr)
00012e e110                                 ldi     r17, 16
00012f e200                                 ldi     r16, ' '
                                    CLRloop1:
000130 930d                                 st      X+, r16         ; load data to DM
000131 951a                                 dec     r17
000132 f7e9                                 brne    CLRloop1
                                 
000133 911f                      	   pop	   r17
000134 910f                      	   pop	   r16
000135 91af                      	   pop	   XL
000136 91bf                      	   pop	   XH
                                 
000137 9508                                 ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	CLRDM2
                                 ;* Desc:	This function clears Data Memory by writing 16 
                                 ;*		consecutive ASCII spaces $20 to the memory at $0110.
                                 ;*****************************************************************
                                 CLRDM2:
                                     ; Set X register points to $0110
000138 93bf                      	   push	   XH
000139 93af                      	   PUSH	   XL
00013a 930f                                 push    r16
00013b 931f                                 push    r17
                                 
00013c e0b1                                 ldi     XH, HIGH(lcd_buffer_addr+16)
00013d e1a0                                 ldi     XL, LOW(lcd_buffer_addr+16)
00013e e110                                 ldi     r17, 16
00013f e200                                 ldi     r16, ' '
                                    CLRloop2:
000140 930d                                 st      X+, r16         ; load data to DM
000141 951a                                 dec     r17
000142 f7e9                                 brne    CLRloop2
                                 
000143 911f                      	   pop	   r17
000144 910f                      	   pop	   r16
000145 91af                      	   pop	   XL
000146 91bf                      	   pop	   XH
                                 
000147 9508                                 ret
                                 ;*****************************************************************
                                 ;* Func:	LCDClrLn1
                                 ;* Desc:	This function clears the top line of the LCD screen.
                                 ;*****************************************************************
                                 LCDClrLn1:
000148 931f                      	push	r17
                                 	; r17 specifies the target bank in LCD RAM
000149 e013                      	ldi	r17, 3
00014a d060                      	rcall	LCD_Internal_ClearLn
00014b dfdc                      	rcall	CLRDM1
00014c 911f                      	pop	r17
00014d 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDClrLn2
                                 ;* Desc:	This function clears the bottom line of the LCD screen.
                                 ;*****************************************************************
                                 LCDClrLn2:
00014e 931f                      	push	r17
                                 	; r17 specifies the target bank in LCD RAM
00014f e011                      	ldi	r17, 1
000150 d05a                      	rcall	LCD_Internal_ClearLn
000151 dfe6                      	rcall	CLRDM2
000152 911f                      	pop	r17
000153 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	Bin2ASCII
                                 ;* Desc:	Converts a binary number into an ASCII 
                                 ;*			text string equivalent. 
                                 ;*			- The binary number needs to be in the mpr
                                 ;*			- The Start Address of where the text will
                                 ;*			 	be placed needs to be in the X Register
                                 ;*			- The count of the characters created are 
                                 ;*				added to the count register
                                 ;*****************************************************************
                                 Bin2ASCII:
000154 930f                      	push	mpr			; save mpr
000155 936f                      	push	r			; save r
000156 935f                      	push	q			; save q
000157 93bf                      	push	XH			; save X-pointer
000158 93af                      	push	XL			;
                                 
                                 	; Determine the range of mpr
000159 3604                      	cpi	mpr, 100		; is mpr >= 100
00015a f018                      	brlo	B2A_1			; goto next check
00015b e043                      	ldi	count, 3		; Three chars are written
00015c 9613                      	adiw	XL, 3			; Increment X 3 address spaces
00015d c007                      	rjmp	B2A_3			; Continue with program
                                 B2A_1:
00015e 300a                      	cpi	mpr, 10		; is mpr >= 10
00015f f018                      	brlo	B2A_2			; Continue with program
000160 e042                      	ldi	count, 2		; Two chars are written
000161 9612                      	adiw	XL, 2			; Increment X 2 address spaces
000162 c002                      	rjmp	B2A_3			; Continue with program
                                 B2A_2:
000163 9611                      	adiw	XL, 1			; Increment X 1 address space
000164 e041                      	ldi	count, 1		; One char is written
                                 
                                 B2A_3:
                                 	; Do-While statement that converts Binary to ASCII
000165 d076                      	rcall	div10			; Call the div10 function
000166 e300                      	ldi	mpr, '0'		; Set the base ASCII integer value
000167 0f06                      	add	mpr, r		; Create the ASCII integer value
000168 930e                      	st	-X, mpr		; Load ASCII value to memory
000169 2f05                      	mov	mpr, q		; Set mpr to quotient value
00016a 3000                      	cpi	mpr, 0		; does mpr == 0
00016b f7c9                      	brne	B2A_3			; do while (mpr != 0)
                                 
00016c 91af                      	pop	XL			; restore X-pointer
00016d 91bf                      	pop	XH			;
00016e 915f                      	pop	q			; restore q
00016f 916f                      	pop	r			; restore r
000170 910f                      	pop	mpr			; restore mpr
000171 9508                      	ret				; return from function
                                 
                                 ;*****************************************************************
                                 ;*	The functions below here are intended for internal use only.
                                 ;*****************************************************************
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCD_Internal_WriteLn
                                 ;* Desc:	Sends 16 characters of information to the LCD panel
                                 ;*		This is slightly more complicated than it sounds because the
                                 ;*		characters straddle two banks of the LCD memory.
                                 ;*		X is pointing at the first ASCII character to be displayed.
                                 ;*		r17 holds the index of the destination bank in LCD RAM.
                                 ;*		
                                 ;*****************************************************************
                                 LCD_Internal_WriteLn:
000172 920f                      	push	r0
000173 921f                      	push	r1
000174 930f                      	push	mpr
000175 932f                      	push	r18
000176 933f                      	push	r19
000177 938f                      	push	r24
000178 939f                      	push	r25
000179 93ef                      	push	ZL
00017a 93ff                      	push	ZH
                                 
                                 	; r25:24 holds a pointer to the base address of the bitmap array
00017b e094                      	ldi	r25, HIGH(FontBitmap << 1);
00017c e084                      	ldi	r24, LOW(FontBitmap << 1);
                                 
00017d 9828                      	cbi	PORTB, 0	; activate slave select
                                 
                                 	; use a counter to track if we are on the top chunk or bottom chunk of each char
00017e e022                      	ldi	r18, 2
                                 
                                 LCD_WL_display_bank:
                                 	; set the column to 0
00017f e100                      	ldi	mpr, lcd_c_disp_set_col_addr_h
000180 d04a                      	rcall	LCD_Internal_WriteCMD
000181 e000                      	ldi	mpr, lcd_c_disp_set_col_addr_l
000182 d048                      	rcall	LCD_Internal_WriteCMD
                                 	; we need to select the appropriate page
000183 eb00                      	ldi	mpr, lcd_c_disp_set_page_addr
000184 2b01                      	or	mpr, r17	; set the lower 4 bits
000185 d045                      	rcall	LCD_Internal_WriteCMD
                                 
000186 e130                      	ldi	r19, 16	; there are 16 characters per line
                                 
                                 LCD_WL_next_char:
                                 	; get ascii code point & determine location of corresponding character bitmap
000187 900d                      	ld	r0, X+	; this should be a value from 0 to 255
000188 e100                      	ldi	mpr, 16	; there are 16 bytes per character
000189 9e00                      	mul	r0, mpr	; determine the byte offset for the desired char
00018a 01fc                      	movw	ZH:ZL, r25:r24	; copy the base address to Z
00018b 0de0                      	add	ZL, r0	; finally, compute a pointer to the char bitmap
00018c 1df1                      	adc	ZH, r1
                                 
00018d e008                      	ldi	mpr, 8	; there are 8 columns for each character
                                 
                                 	; this is where we display the chunk of character (either a top chunk or bottom chunk)
00018e 9004                      	lpm	r0, Z
                                 LCD_WL_next_col:
00018f bc0e                      	out	SPDR, r0
000190 9a89                      	sbi	PORTF, 1	; set lcd_A0 to specify data mode
000191 9632                      	adiw	ZH:ZL, 2	; point Z at the next column for this bank
000192 9004                      	lpm	r0, Z		; this is a sneaky way to save a few clock cycles (since we are waiting for the SPI communication)
                                 LCD_WL_wait_spi:
000193 b41d                      	in	r1, SPSR
000194 fe17                      	sbrs	r1, SPIF	; wait for SPI to finish
000195 cffd                      	rjmp	LCD_WL_wait_spi
                                 
                                 	; keep going until we have displayed all the columns for this character
000196 950a                      	dec	mpr
000197 f7b9                      	brne	LCD_WL_next_col
                                 
                                 	; move to the next character
000198 953a                      	dec	r19
000199 f769                      	brne	LCD_WL_next_char
                                 
                                 	; if we are at the end of the line, configure the bank and starting array offset for the bottom half of each char
00019a 952a                      	dec	r18		; did we display both banks yet?
00019b f021                      	breq	LCD_WL_all_done
                                 	; if not, then prepare to display the bottom chunk of each character
00019c 951a                      	dec	r17		; decrement the bank number
00019d 9750                      	sbiw	XH:XL, 16	; X needs to point back at the beginning character of the line
00019e 9601                      	adiw	r25:r24, 1	; increment the base address pointer (now it will point to the second chunk of each char)
00019f cfdf                      	rjmp	LCD_WL_display_bank
                                 
                                 LCD_WL_all_done:
0001a0 9a28                      	sbi	PORTB, 0	; deactivate slave select
                                 
0001a1 91ff                      	pop	ZH
0001a2 91ef                      	pop	ZL
0001a3 919f                      	pop	r25
0001a4 918f                      	pop	r24
0001a5 913f                      	pop	r19
0001a6 912f                      	pop	r18
0001a7 910f                      	pop	mpr
0001a8 901f                      	pop	r1
0001a9 900f                      	pop	r0
0001aa 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCD_Internal_ClearLn
                                 ;* Desc:	This function clears two of the LCD memory banks.
                                 ;*		r17 specifies the starting bank to wipe.
                                 ;*****************************************************************
                                 LCD_Internal_ClearLn:
0001ab 930f                      	push	mpr
0001ac 921f                      	push	r1
0001ad 932f                      	push	r18
0001ae 933f                      	push	r19
                                 
0001af 9828                      	cbi	PORTB, 0	; activate slave select
0001b0 e032                      	ldi	r19, 2	; we are going to clear two banks
                                 
                                 LCD_CLRLN_clear_bank:
                                 	; set the column to 0
0001b1 e100                      	ldi	mpr, lcd_c_disp_set_col_addr_h
0001b2 d018                      	rcall	LCD_Internal_WriteCMD
0001b3 e000                      	ldi	mpr, lcd_c_disp_set_col_addr_l
0001b4 d016                      	rcall	LCD_Internal_WriteCMD
                                 	; we need to select the appropriate page
0001b5 eb00                      	ldi	mpr, lcd_c_disp_set_page_addr
0001b6 2b01                      	or	mpr, r17	; configure the lower 4 bits
0001b7 d013                      	rcall	LCD_Internal_WriteCMD
                                 
0001b8 e820                      	ldi	r18, 128	; there are 128 columns on the LCD
0001b9 2700                      	clr	mpr		; we will fill each column with empty dots (i.e. blank space)
0001ba 9a89                      	sbi	PORTF, 1	; set lcd_A0 to specify data mode
                                 
                                 LCD_CLRLN_write_col:
0001bb bd0e                      	out	SPDR, mpr	; send an empty column to the LCD via SPI
                                 LCD_CLRLN_wait_spi:
0001bc b41d                      	in	r1, SPSR
0001bd fe17                      	sbrs	r1, SPIF	; wait for SPI to finish
0001be cffd                      	rjmp	LCD_CLRLN_wait_spi
                                 
0001bf 952a                      	dec	r18
0001c0 f7d1                      	brne	LCD_CLRLN_write_col	; cycle through all 128 columns
                                 
                                 	; clear the remaining bank if we haven't done so already
0001c1 953a                      	dec	r19
0001c2 f011                      	breq	LCD_CLRLN_all_done
0001c3 951a                      	dec	r17		; decrement the bank index
0001c4 cfec                      	rjmp	LCD_CLRLN_clear_bank
                                 
                                 LCD_CLRLN_all_done:
0001c5 9a28                      	sbi	PORTB, 0	; deactivate slave select	
                                 	
                                 	; pop registers...
0001c6 913f                      	pop	r19
0001c7 912f                      	pop	r18
0001c8 901f                      	pop	r1
0001c9 910f                      	pop	mpr
0001ca 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCD_Internal_WriteCMD
                                 ;* Desc:	Sends the byte in mpr
                                 ;*		If you use this function directly,
                                 ;*		YOU ARE RESPONSIBLE for handling the slave select line!
                                 ;*****************************************************************
                                 LCD_Internal_WriteCMD:
0001cb bd0e                      	out	SPDR, mpr	; initiate transmission
0001cc 9889                      	cbi	PORTF, 1	; clear lcd_A0 to put the lcd into command mode
                                 				; (this just has to be done before the 8th bit
                                 				; is transmitted via SPI)
                                 LCD_IWC_L1:
0001cd b50d                      	in	mpr, SPSR
0001ce ff07                      	sbrs	mpr, SPIF	; wait for SPI to finish
0001cf cffd                      	rjmp LCD_IWC_L1
0001d0 9508                      	ret
                                 
                                 ;*****************************************************************
                                 ;* Func:	LCDDelay
                                 ;* Desc:	A wait loop that will consume roughly 1ms
                                 ;*		Note that a CALL takes 4 cycles on top of this delay.
                                 ;*****************************************************************
                                 LCDDelay:
0001d1 930f                      	push	mpr		; 2 cycles
0001d2 931f                      	push	r17		; 2 cycles
0001d3 e01b                      	ldi	r17, 11	; 1 cycle
                                 LCDDelay_L1:
0001d4 ef02                      	ldi	mpr, 242	; 1 cycle
                                 LCDDelay_L2:
0001d5 950a                      	dec	mpr		; 1 cycle
0001d6 f7f1                      	brne	LCDDelay_L2	; 2 cycles on branch, 1 if no branch
0001d7 951a                      	dec	r17		; 1 cycle
0001d8 f7d9                      	brne	LCDDelay_L1	; 2 cycles on branch, 1 if no branch
0001d9 911f                      	pop	r17		; 2 cycles
0001da 910f                      	pop	mpr		; 2 cycles
0001db 9508                      	ret			; 4 cycles
                                 
                                 ;*****************************************************************
                                 ;* Func:	div10
                                 ;* Desc:	Divides the value in the mpr by 10 and 
                                 ;*			puts the remainder in the 'r' register
                                 ;*			and the quotient in the 'q' register.
                                 ;*	DO NOT modify this function, trust me, it does
                                 ;*	divide by 10 :)  ~DZ		
                                 ;*****************************************************************
                                 div10:
0001dc 920f                      	push	r0		; Save register
                                 
                                 	; q = mpr / 10 = mpr * 0.000110011001101b
0001dd 2f50                      	mov	q, mpr	; q = mpr * 1.0b
0001de 9556                      	lsr	q		; q >> 2
0001df 9556                      	lsr	q		; q = mpr * 0.01b
0001e0 0f50                      	add	q, mpr	; q = (q + mpr) >> 1
0001e1 9556                      	lsr	q		; q = mpr * 0.101b
0001e2 0f50                      	add	q, mpr	; q = (q + mpr) >> 3
0001e3 9556                      	lsr	q
0001e4 9556                      	lsr	q
0001e5 9556                      	lsr	q		; q = mpr * 0.001101b
0001e6 0f50                      	add	q, mpr	; q = (q + mpr) >> 1
0001e7 9556                      	lsr	q		; q = mpr * 0.1001101b
0001e8 0f50                      	add	q, mpr	; q = (q + mpr) >> 3
0001e9 9556                      	lsr	q				
0001ea 9556                      	lsr	q
0001eb 9556                      	lsr	q		; q = mpr * 0.0011001101b
0001ec 0f50                      	add	q, mpr	; q = (q + mpr) >> 1
0001ed 9556                      	lsr	q		; q = mpr * 0.10011001101b
0001ee 0f50                      	add	q, mpr	; q = (q + mpr) >> 4
0001ef 9556                      	lsr	q
0001f0 9556                      	lsr	q
0001f1 9556                      	lsr	q
0001f2 9556                      	lsr	q		; q = mpr * 0.000110011001101b
                                 
                                 	; compute the remainder as r = i - 10 * q
                                 	; calculate r = q * 10 = q * 1010b
0001f3 2f65                      	mov	r, q		; r = q * 1
0001f4 0f66                      	lsl	r		; r << 2
0001f5 0f66                      	lsl	r		; r = q * 100b
0001f6 0f65                      	add	r, q		; r = (r + q) << 1
0001f7 0f66                      	lsl	r		; r = q * 1010b
0001f8 2e06                      	mov	r0, r		; r0 = 10 * q
0001f9 2f60                      	mov	r, mpr	; r = mpr
0001fa 1960                      	sub	r, r0		; r = mpr - 10 * q
                                 
                                 	; Fix any errors that occur
                                 div10_1:
0001fb 306a                      	cpi	r, 10		; Compare with 10
0001fc f018                      	brlo	div10_2	; do nothing if r < 10
0001fd 9553                      	inc	q		; fix quotient
0001fe 506a                      	subi	r, 10		; fix remainder
0001ff cffb                      	rjmp	div10_1	; Continue until error is corrected
                                 
                                 div10_2:
000200 900f                      	pop	r0		; Restore registers
000201 9508                      	ret			; Return from function
                                 
                                 ;*********************************************************************
                                 ;*	Bitmap Font Information
                                 ;*	Adapted into assembly code by Justin Goins.
                                 ;*	You can edit characters or add symbols if you choose (by modifying the data below)
                                 ;*	Each character is represented as a 8 x 16 pattern of dots (8 dots wide and 16 dots high).
                                 ;*	This implies that 16 bytes are allocated to represent each character.
                                 ;*
                                 ;*	The character information is arranged so that each line below equates to a single character.
                                 ;*	The first line is ASCII character 0, the next line is ASCII character 1,
                                 ;*	the next line is ASCII character 2, and so on.
                                 ;*	You can assign characters to any index within the extended ASCII range (0 to 255).
                                 ;*	With a bit of experimentation it's possible to define and display emojis (or any other graphical output).
                                 ;*	Be creative and have fun!
                                 ;*
